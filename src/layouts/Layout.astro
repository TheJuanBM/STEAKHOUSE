        url: baseUrl,
        logo: {
          "@type": "ImageObject",
          "@id": `${baseUrl}#logo`,
          url: `${baseUrl}/logo.png`,
        },
        image: [imageURL, `${baseUrl}/og-image.jpg`],
        areaServed: {
          "@type": "Place",
          name: "Caucasia Antioquia Colombia",
        },
        mainEntityOfPage: {
          "@id": `${baseUrl}#website`,
        },
        parentOrganization: {
          "@id": `${baseUrl}#organization`,
        },
        servesCuisine: [
          "Steakhouse",
          "Parrilla",
          "Comida Gourmet",
          "Restaurante Premium",
        ],
        address: {
