          postalCode: "052410",
          addressCountry: "CO",
        },
        location: {
          "@type": "Place",
          "@id": `${baseUrl}#place`,
          name: "LF Steakhouse",
          address: {
            "@id": `${baseUrl}#address`,
          },
          geo: {
            "@id": `${baseUrl}#geo`,
          },
        },
        geo: {
          "@type": "GeoCoordinates",
          "@id": `${baseUrl}#geo`,
          latitude: 7.999502155398765,
          longitude: -75.23093994479436,
        },
        telephone: `+${import.meta.env.PUBLIC_WHATSAPP_NUMBER ?? "573042582119"}`,
        // email: "TODO: add email",
        sameAs: [
          "https://instagram.com/lf.steakhouse",
          "https://maps.google.com/?q=7.999502155398765,-75.23093994479436",
        ],
        hasOfferCatalog: {
          "@type": "OfferCatalog",
          "@id": `${baseUrl}/menu#catalog`,
          name: "Menú LF Steakhouse",
          url: `${baseUrl}/menu`,
        },
        priceRange: "$$$",
        currenciesAccepted: "COP",
        paymentAccepted:
          "Efectivo, Tarjeta de Crédito, Tarjeta de Débito, Transferencia Bancaria",
        knowsAbout: [
          "Restaurante en Caucasia",
          "Parrilla",
          "Carnes",
          "Steakhouse",
          "Comida gourmet",
          "Restaurante en Antioquia",
        ],
        openingHoursSpecification: [
          {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
            opens: "08:00",
            closes: "23:00",
          },
        ],
        brand: {
          "@type": "Brand",
          name: "LF Steakhouse",
        },
        foundingLocation: {
          "@type": "Place",
          name: "Caucasia, Antioquia, Colombia",
        },
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue,
          reviewCount,
          bestRating: "5",
          worstRating: "1",
        },
        petsAllowed: true,
        acceptsReservations: `${baseUrl}/reservar`,
        amenityFeature: [
          {
            "@type": "LocationFeatureSpecification",
            name: "Reserva",
            value: true,
          },
          {
            "@type": "LocationFeatureSpecification",
            name: "WiFi Gratis",
            value: true,
          },
          {
            "@type": "LocationFeatureSpecification",
            name: "Aire Acondicionado",
            value: true,
          },
          {
            "@type": "LocationFeatureSpecification",
            name: "Estacionamiento",
            value: true,
          },
          {
            "@type": "LocationFeatureSpecification",
            name: "Cena",
            value: true,
          },
          {
            "@type": "LocationFeatureSpecification",
            name: "Bar",
            value: true,
          },
          {
            "@type": "LocationFeatureSpecification",
            name: "Eventos",
            value: true,
          },
          {
            "@type": "LocationFeatureSpecification",
            name: "Ambiente",
            value: true,
          },
          {
            "@type": "LocationFeatureSpecification",
            name: "Platillos",
            value: true,
          },
          {
            "@type": "LocationFeatureSpecification",
            name: "Experiencia",
            value: true,
          },
        ],
        inLanguage: "es-CO",
        hasMap:
          "https://maps.google.com/?q=7.999502155398765,-75.23093994479436",
      })}
    />

    <!-- JSON-LD Schema for Organization -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        "@id": `${baseUrl}#organization`,
        name: "LF Steakhouse",
        url: baseUrl,
        logo: {
          "@type": "ImageObject",
          "@id": `${baseUrl}#logo`,
          url: `${baseUrl}/logo.png`,
        },
        contactPoint: {
          "@type": "ContactPoint",
          telephone: `+${import.meta.env.PUBLIC_WHATSAPP_NUMBER ?? "573042582119"}`,
          contactType: "reservations",
          availableLanguage: ["Spanish", "English"],
          areaServed: "CO",
        },
        inLanguage: "es-CO",
        sameAs: [
          "https://instagram.com/lf.steakhouse",
          "https://maps.google.com/?q=7.999502155398765,-75.23093994479436",
        ],
      })}
    />

    <!-- JSON-LD Schema for WebSite (Search Action) -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": `${baseUrl}#website`,
        url: baseUrl,
        name: "LF Steakhouse",
        description: "El mejor restaurante de la zona",
        publisher: {
          "@id": `${baseUrl}#organization`,
        },
        about: {
          "@id": `${baseUrl}#restaurant`,
        },
        mainEntity: {
          "@id": `${baseUrl}#restaurant`,
        },
        potentialAction: {
          "@type": "SearchAction",
          target: `${baseUrl}/?q={search_term_string}`,
          "query-input": "required name=search_term_string",
        },
        inLanguage: "es-CO",
      })}
    />

    <!-- JSON-LD Schema for BreadcrumbList -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          itemListElement,
        },
        null,
        2,
      )}
    />
    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HZVL785YP2"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HZVL785YP2');
    </script>
  </head>
  <body>
    <!-- Splash Screen: visible hasta que window.load dispara -->
    <div id="lf-splash" role="status" aria-label="Cargando LF Steakhouse" aria-live="polite">
      <div id="lf-splash-inner">
        <p id="lf-splash-lf">LF</p>
        <div id="lf-splash-rule"></div>
        <p id="lf-splash-name">STEAKHOUSE</p>
      </div>
    </div>
    <script is:inline>
      (function () {
        document.body.style.overflow = 'hidden';
        function hideSplash() {
          var el = document.getElementById('lf-splash');
          if (!el) return;
          el.classList.add('lf-splash--out');
          el.addEventListener('transitionend', function () {
            el.remove();
            document.body.style.overflow = '';
          }, { once: true });
        }
        if (document.readyState === 'complete') {
          hideSplash();
        } else {
          window.addEventListener('load', hideSplash, { once: true });
        }
      })();
    </script>

    <slot />
  </body>
</html>

<style is:global>
  /* ── Splash Screen ─────────────────────────────────────── */
  #lf-splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background-color: var(--burgundy-dark, #2d1717);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition: opacity 0.65s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }
  #lf-splash.lf-splash--out {
    opacity: 0;
    pointer-events: none;
  }
  #lf-splash-inner {
    text-align: center;
    animation: splashEnter 0.9s cubic-bezier(0.4, 0, 0.2, 1) both;
  }
  @keyframes splashEnter {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  #lf-splash-lf {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(4.5rem, 18vw, 9rem);
    font-style: italic;
    font-weight: 300;
    color: var(--cream, #f5e6c8);
    line-height: 1;
    letter-spacing: 0.04em;
  }
  #lf-splash-rule {
    width: 2.5rem;
    height: 1px;
    background: var(--cream-dark, #e5d6b8);
    margin: 1.1rem auto;
    opacity: 0.5;
  }
  #lf-splash-name {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(0.55rem, 2.2vw, 0.8rem);
    font-weight: 400;
    color: var(--cream-dark, #e5d6b8);
    letter-spacing: 0.42em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  /* ── /Splash Screen ─────────────────────────────────────── */

  /* i18n — default: show Spanish, hide English */
  /* Explicit inherit so scanners follow the parent's already-explicit hex color */
  .i18n-es,
  .i18n-en {
    color: inherit;
  }
  .i18n-en {
    display: none;
  }
  html[lang="en"] .i18n-es {
    display: none;
  }
  html[lang="en"] .i18n-en {
    display: revert;
  }

  :root {
    --burgundy: #3d1f1f;
    --burgundy-light: #4a2828;
    --burgundy-dark: #2d1717;
    --cream: #f5e6c8;
    --cream-light: #fff8e7;
    --cream-dark: #e5d6b8;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    -webkit-tap-highlight-color: transparent;
  }

  body {
    font-family: "Montserrat", sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    background-color: var(--burgundy);
    min-height: 100vh;
  }

  ::-webkit-scrollbar {
    width: 6px;
  }

  ::-webkit-scrollbar-track {
    background: var(--burgundy-dark);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--cream-dark);
    border-radius: 3px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--cream);
  }
</style>
