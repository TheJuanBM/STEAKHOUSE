---
interface Props {
  title: string;
  image?: string;
  keywords?: string;
  description?: string;
}

const {
  title = "LF Steakhouse",
  image = "/fotos/og-image.png",
  description = "Restaurante premium en Caucasia Antioquia especializado en carnes, parrilla y comida gourmet. Reservas online en LF Steakhouse.",
  keywords = "lfsteakhouse, Caucasia, reservar restaurante lujo, comida premium Bajo Cauca, confirmación inmediata restaurante, gastronomía, lf, steakhouse, comida de calidad",
} = Astro.props;
const imageURL = new URL(image, Astro.site).toString();
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const baseUrl = Astro.site?.toString() || "https://lfsteakhouse.com";

const siteName = "LF Steakhouse";

let ratingValue = "5.0";
let reviewCount = "26";
const placesKey = import.meta.env.GOOGLE_PLACES_API_KEY;
const placeId = import.meta.env.GOOGLE_PLACE_ID;
if (placesKey && placeId) {
  try {
    const res = await fetch(
      `https://maps.googleapis.com/maps/api/place/details/json?place_id=${placeId}&fields=rating,user_ratings_total&key=${placesKey}`,
    );
    const data = await res.json();
    if (data.result?.rating) ratingValue = String(data.result.rating);
    if (data.result?.user_ratings_total)
      reviewCount = String(data.result.user_ratings_total);
  } catch {
    console.error("Error fetching Google Places data");
  }
}

const itemListElement = [
  { name: "Inicio", url: baseUrl },
  { name: "LF Steakhouse", url: baseUrl },
].map((crumb, index) => ({
  "@type": "ListItem",
  position: index + 1,
  name: crumb.name,
  item: crumb.url,
}));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <!-- Language detection — runs before paint to avoid flash -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("lf-lang");
        var nav = navigator.language || "";
        var lang = stored || (nav.startsWith("en") ? "en" : "es");
        if (lang === "en") document.documentElement.setAttribute("lang", "en");
      })();
    </script>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes"
    />

    <!-- Preconnect para recursos críticos externos -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.google.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Google Fonts — cargado de forma no bloqueante -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300&family=Montserrat:wght@300;400;500;600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300&family=Montserrat:wght@300;400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300&family=Montserrat:wght@300;400;500;600&display=swap"
      />
    </noscript>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="LF Steakhouse" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Hreflang — same URL serves both languages -->
    <link rel="alternate" hreflang="es-CO" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <!-- Geo Meta Tags -->
    <meta name="geo.region" content="CO-ANT" />
    <meta name="geo.placename" content="Caucasia, Antioquia" />
    <meta name="geo.position" content="7.999502155398765;-75.23093994479436" />
    <meta name="ICBM" content="7.999502155398765, -75.23093994479436" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:secure_url" content={imageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} - LF Steakhouse`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@lfsteakhouse" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={`${title} - LF Steakhouse`} />

    <!-- Favicon SVG para navegadores modernos (prioridad, soporta tema claro/oscuro) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href="/icons/favicon-96x96.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href="/icons/favicon-48x48.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-16x16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon-180x180.png"
    />

    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- PWA & App Meta Tags -->
    <meta
      name="theme-color"
      content="#3d1f1f"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#2d1717"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="apple-mobile-web-app-title" content="LF Steakhouse" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content={siteName} />
    <meta name="msapplication-TileColor" content="#3d1f1f" />
    <meta name="msapplication-TileImage" content="/icons/icon-144x144.png" />
    <meta name="msapplication-config" content="/browserconfig.xml" />

    <meta name="generator" content={Astro.generator} />
    <!-- Sin JS: ocultar splash inmediatamente -->
    <noscript><style>#lf-splash{display:none!important}</style></noscript>

    <!-- JSON-LD Schema for LFSteakhouse -->
    <script
