---
import Trans from "../i18n/Trans.astro";
---

<section class="hero">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="ornament">
      <span class="line"></span>
      <span class="diamond"></span>
      <span class="line"></span>
    </div>
    <div class="logo-wrapper">
      <img src="/logo.jpg" alt="LF Steakhouse" class="hero-logo" />
    </div>
    <p class="subtitle">
      <Trans es="Cocina de autor con alma tradicional" en="Chef-driven cuisine with a traditional soul" />
    </p>
    <div class="cta-group">
      <a href="/reservar" class="btn btn-primary">
        <Trans es="Reservar Mesa" en="Reserve a Table" />
      </a>
      <a href="/menu" class="btn btn-secondary">
        <Trans es="Ver menú" en="View Menu" />
      </a>
    </div>
  </div>
  <div class="scroll-indicator">
    <span class="scroll-text">
      <Trans es="Descubre" en="Discover" />
    </span>
    <span class="scroll-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--burgundy);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      transparent 0%,
      rgba(45, 23, 23, 0.4) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 100px 24px 60px;
    max-width: 600px;
    animation: heroFadeIn 1.6s ease-out forwards;
    opacity: 0;
  }

  @keyframes heroFadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 24px 0;
  }

  .ornament .line {
    width: 40px;
    height: 1px;
    background-color: rgba(245, 230, 200, 0.4);
  }

  .ornament .diamond {
    width: 8px;
    height: 8px;
    background-color: rgba(245, 230, 200, 0.5);
    transform: rotate(45deg);
  }

  .logo-wrapper {
    margin-bottom: 16px;
    position: relative;
    display: inline-block;
  }

  .logo-wrapper::before {
    content: "";
    position: absolute;
    inset: -20px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgba(245, 230, 200, 0.12) 0%,
      rgba(245, 230, 200, 0.04) 40%,
      transparent 70%
    );
    pointer-events: none;
  }

  .hero-logo {
    max-width: 260px;
    width: 70%;
    height: auto;
    display: block;
    margin: 0 auto;
    border-radius: 20%;
    filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.5))
      drop-shadow(0 0 40px rgba(245, 230, 200, 0.15));
    transition:
      transform 0.4s ease,
      filter 0.4s ease;
  }

  .logo-wrapper:hover .hero-logo {
    transform: scale(1.03);
    filter: drop-shadow(0 12px 32px rgba(0, 0, 0, 0.5))
      drop-shadow(0 0 56px rgba(245, 230, 200, 0.22));
  }

  @media (min-width: 768px) {
    .hero-logo {
      max-width: 320px;
      width: 100%;
    }
  }

  .subtitle {
    font-family: "Montserrat", sans-serif;
    font-size: 14px;
    font-weight: 300;
    color: rgba(245, 230, 200, 0.8);
    letter-spacing: 3px;
    text-transform: uppercase;
    margin: 40px 0;
  }

  @media (min-width: 768px) {
    .subtitle {
      font-size: 16px;
      letter-spacing: 4px;
    }
  }

  .cta-group {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
  }

  @media (min-width: 480px) {
    .cta-group {
      flex-direction: row;
      justify-content: center;
    }
  }

  .btn {
    font-family: "Montserrat", sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 16px 32px;
    transition: all 0.3s ease;
    width: 100%;
  }

  .btn-primary {
    background-color: var(--cream);
    color: var(--burgundy);
  }

  .btn-primary:hover {
    background-color: var(--cream-light);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--cream);
    border: 1px solid rgba(245, 230, 200, 0.4);
  }

  .btn-secondary:hover {
    border-color: var(--cream);
    background-color: rgba(245, 230, 200, 0.1);
  }

  .scroll-indicator {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .scroll-text {
    font-family: "Montserrat", sans-serif;
    font-size: 10px;
    font-weight: 400;
    color: rgba(245, 230, 200, 0.5);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(
      to bottom,
      rgba(245, 230, 200, 0.5),
      transparent
    );
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%,
    100% {
      opacity: 0.5;
      transform: scaleY(1);
    }
    50% {
      opacity: 1;
      transform: scaleY(1.2);
    }
  }
</style>
