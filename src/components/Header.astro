---
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  currentPage?: string;
}

const { currentPage = "" } = Astro.props;

const links = [
  { href: "/",         es: "Inicio",  en: "Home" },
  { href: "/menu",     es: "Menú",    en: "Menu" },
  { href: "/galeria",  es: "Galería", en: "Gallery" },
  { href: "/reservar", es: "Reservar",en: "Reserve" },
  { href: "/blog",     es: "Blog",    en: "Blog" },
];
---

<header>
  <div class="header-inner">

    <nav class="nav-desktop">
      {links.map((link) => (
        <a href={link.href} class:list={["nav-link", { active: currentPage === link.href }]}>
          <span class="i18n-es">{link.es}</span>
          <span class="i18n-en">{link.en}</span>
        </a>
      ))}
    </nav>

    <div class="lang-desktop">
      <LanguageSwitcher />
    </div>

    {currentPage !== "/" && (
      <button class="back-btn" id="back-btn" aria-label="Volver atrás">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </button>
    )}

    <div class="mobile-actions">
      <button class="menu-btn" id="menu-btn" aria-label="Menú">
        <span class="menu-line"></span>
        <span class="menu-line"></span>
      </button>
    </div>

  </div>

  <nav class="nav-mobile" id="nav-mobile">
    <div class="nav-mobile-inner">
      {links.map((link) => (
        <a href={link.href} class:list={["nav-mobile-link", { active: currentPage === link.href }]}>
          <span class="i18n-es">{link.es}</span>
          <span class="i18n-en">{link.en}</span>
        </a>
      ))}
      <div class="lang-mobile">
        <LanguageSwitcher />
      </div>
    </div>
  </nav>
</header>

<!-- Backdrop: cubre el contenido cuando el menú mobile está abierto -->
<div id="menu-backdrop" aria-hidden="true"></div>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background-color: transparent;
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    transition:
      background-color 0.4s ease,
      backdrop-filter 0.4s ease,
      -webkit-backdrop-filter 0.4s ease;
  }

  header.scrolled {
    background-color: rgba(61, 31, 31, 0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 20px;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }

  @media (min-width: 768px) {
    .header-inner {
      padding: 32px 40px;
    }
  }

  /* Desktop nav — centered */
  .nav-desktop {
    display: none;
    align-items: center;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .nav-desktop {
      display: flex;
    }
  }

  .lang-desktop {
    display: none;
    position: absolute;
    right: 40px;
  }

  @media (min-width: 768px) {
    .lang-desktop {
      display: flex;
    }
  }

  .nav-link {
    font-family: "Montserrat", sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: rgba(245, 230, 200, 0.7);
    text-decoration: none;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 8px 0;
    position: relative;
    transition: color 0.2s ease;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background-color: #f5e6c8;
    transition: width 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #f5e6c8;
  }

  .nav-link.active::after,
  .nav-link:hover::after {
    width: 100%;
  }

  .back-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    left: 20px;
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(245, 230, 200, 0.7);
    padding: 8px 0;
    transition: color 0.2s ease;
  }

  .back-btn:hover {
    color: #f5e6c8;
  }

  @media (min-width: 768px) {
    .back-btn {
      display: none;
    }
  }

  /* Mobile */
  .mobile-actions {
    display: flex;
    align-items: center;
    position: absolute;
    right: 20px;
  }

  @media (min-width: 768px) {
    .mobile-actions {
      display: none;
    }
  }

  .menu-btn {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .menu-line {
    display: block;
    width: 24px;
    height: 1px;
    background-color: #f5e6c8;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .menu-btn.open .menu-line:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .menu-btn.open .menu-line:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .nav-mobile {
    background-color: #3d1f1f;
    border-top: 1px solid rgba(245, 230, 200, 0.1);
    /* Transición por max-height para poder animar sin display:none */
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-mobile.open {
    max-height: 420px;
  }

  @media (min-width: 768px) {
    .nav-mobile {
      display: none !important;
    }
  }

  #menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: 999; /* justo debajo del header (z-index: 1000) */
    background: rgba(20, 8, 8, 0.45);
    backdrop-filter: blur(7px);
    -webkit-backdrop-filter: blur(7px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.32s ease;
  }

  #menu-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .nav-mobile-inner {
    display: flex;
    flex-direction: column;
    padding: 20px;
  }

  .nav-mobile-link {
    font-family: "Montserrat", sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: rgba(245, 230, 200, 0.7);
    text-decoration: none;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 16px 0;
    border-bottom: 1px solid rgba(245, 230, 200, 0.1);
    transition: color 0.2s ease;
  }

  .nav-mobile-link:last-of-type {
    border-bottom: none;
  }

  .lang-mobile {
    padding-top: 20px;
    border-top: 1px solid rgba(245, 230, 200, 0.1);
    margin-top: 4px;
  }

  .nav-mobile-link:hover,
  .nav-mobile-link.active {
    color: #f5e6c8;
  }
</style>

<script>
  function initScrollHeader() {
    const header = document.querySelector<HTMLElement>("header");
    if (!header) return;

    function setHeaderHeight() {
      const h = header!.getBoundingClientRect().height;
      if (h > 0) {
        document.documentElement.style.setProperty("--header-height", `${Math.round(h)}px`);
      }
    }

    // Measure immediately, after first paint, and after fonts settle
    setHeaderHeight();
    requestAnimationFrame(setHeaderHeight);
    document.fonts?.ready?.then?.(setHeaderHeight);

    // Keep in sync if the header ever changes size (mobile menu open, resize)
    if ("ResizeObserver" in window) {
      new ResizeObserver(setHeaderHeight).observe(header);
    }

    const onScroll = () => header.classList.toggle("scrolled", window.scrollY > 80);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  initScrollHeader();
  document.addEventListener("astro:after-swap", initScrollHeader);

  function initMobileMenu() {
    const menuBtn = document.getElementById("menu-btn");
    const navMobile = document.getElementById("nav-mobile");
    const backdrop = document.getElementById("menu-backdrop");
    if (!menuBtn || !navMobile) return;

    const newBtn = menuBtn.cloneNode(true) as HTMLElement;
    menuBtn.parentNode?.replaceChild(newBtn, menuBtn);

    function openMenu() {
      newBtn.classList.add("open");
      navMobile.classList.add("open");
      backdrop?.classList.add("open");
    }

    function closeMenu() {
      newBtn.classList.remove("open");
      navMobile.classList.remove("open");
      backdrop?.classList.remove("open");
    }

    newBtn.addEventListener("click", () => {
      newBtn.classList.contains("open") ? closeMenu() : openMenu();
    });

    backdrop?.addEventListener("click", closeMenu);

    navMobile.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  }

  initMobileMenu();
  document.addEventListener("astro:after-swap", initMobileMenu);

  document.getElementById("back-btn")?.addEventListener("click", () => {
    const fromSameSite = document.referrer && new URL(document.referrer).origin === window.location.origin;
    if (fromSameSite) {
      history.back();
    } else {
      window.location.href = "/";
    }
  });
</script>
