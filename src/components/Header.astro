---
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  currentPage?: string;
}

const { currentPage = "" } = Astro.props;

const links = [
  { href: "/",         es: "Inicio",  en: "Home" },
  { href: "/menu",     es: "Menú",    en: "Menu" },
  { href: "/galeria",  es: "Galería", en: "Gallery" },
  { href: "/reservar", es: "Reservar",en: "Reserve" },
];
---

<header>
  <div class="header-inner">

    <nav class="nav-desktop">
      {links.map((link) => (
        <a href={link.href} class:list={["nav-link", { active: currentPage === link.href }]}>
          <span class="i18n-es">{link.es}</span>
          <span class="i18n-en">{link.en}</span>
        </a>
      ))}
    </nav>

    <div class="lang-desktop">
      <LanguageSwitcher />
    </div>

    <div class="mobile-actions">
      <LanguageSwitcher />
      <button class="menu-btn" id="menu-btn" aria-label="Menú">
        <span class="menu-line"></span>
        <span class="menu-line"></span>
      </button>
    </div>

  </div>

  <nav class="nav-mobile" id="nav-mobile">
    <div class="nav-mobile-inner">
      {links.map((link) => (
        <a href={link.href} class:list={["nav-mobile-link", { active: currentPage === link.href }]}>
          <span class="i18n-es">{link.es}</span>
          <span class="i18n-en">{link.en}</span>
        </a>
      ))}
    </div>
  </nav>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background-color: transparent;
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    transition:
      background-color 0.4s ease,
      backdrop-filter 0.4s ease,
      -webkit-backdrop-filter 0.4s ease;
  }

  header.scrolled {
    background-color: rgba(61, 31, 31, 0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px 20px;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }

  @media (min-width: 768px) {
    .header-inner {
      padding: 20px 40px;
    }
  }

  /* Desktop nav — centered */
  .nav-desktop {
    display: none;
    align-items: center;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .nav-desktop {
      display: flex;
    }
  }

  .lang-desktop {
    display: none;
    position: absolute;
    right: 40px;
  }

  @media (min-width: 768px) {
    .lang-desktop {
      display: flex;
    }
  }

  .nav-link {
    font-family: "Montserrat", sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: rgba(245, 230, 200, 0.7);
    text-decoration: none;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 8px 0;
    position: relative;
    transition: color 0.2s ease;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--cream);
    transition: width 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--cream);
  }

  .nav-link.active::after,
  .nav-link:hover::after {
    width: 100%;
  }

  /* Mobile */
  .mobile-actions {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  @media (min-width: 768px) {
    .mobile-actions {
      display: none;
    }
  }

  .menu-btn {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .menu-line {
    display: block;
    width: 24px;
    height: 1px;
    background-color: var(--cream);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .menu-btn.open .menu-line:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .menu-btn.open .menu-line:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .nav-mobile {
    display: none;
    background-color: var(--burgundy);
    border-top: 1px solid rgba(245, 230, 200, 0.1);
  }

  .nav-mobile.open {
    display: block;
  }

  @media (min-width: 768px) {
    .nav-mobile {
      display: none !important;
    }
  }

  .nav-mobile-inner {
    display: flex;
    flex-direction: column;
    padding: 20px;
  }

  .nav-mobile-link {
    font-family: "Montserrat", sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: rgba(245, 230, 200, 0.7);
    text-decoration: none;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 16px 0;
    border-bottom: 1px solid rgba(245, 230, 200, 0.1);
    transition: color 0.2s ease;
  }

  .nav-mobile-link:last-child {
    border-bottom: none;
  }

  .nav-mobile-link:hover,
  .nav-mobile-link.active {
    color: var(--cream);
  }
</style>

<script>
  function initScrollHeader() {
    const header = document.querySelector("header");
    if (!header) return;
    const onScroll = () => header.classList.toggle("scrolled", window.scrollY > 80);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  initScrollHeader();
  document.addEventListener("astro:after-swap", initScrollHeader);

  function initMobileMenu() {
    const menuBtn = document.getElementById("menu-btn");
    const navMobile = document.getElementById("nav-mobile");
    if (!menuBtn || !navMobile) return;

    const newBtn = menuBtn.cloneNode(true) as HTMLElement;
    menuBtn.parentNode?.replaceChild(newBtn, menuBtn);

    newBtn.addEventListener("click", () => {
      newBtn.classList.toggle("open");
      navMobile.classList.toggle("open");
    });

    navMobile.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        newBtn.classList.remove("open");
        navMobile.classList.remove("open");
      });
    });
  }

  initMobileMenu();
  document.addEventListener("astro:after-swap", initMobileMenu);
</script>
