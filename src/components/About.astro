---
import { Image } from "astro:assets";

import copaImg from "../assets/copa.jpg";
import Trans from "../i18n/Trans.astro";
---

<section class="about">
  <div class="container">
    <div class="content">
      <div class="ornament">
        <span class="line"></span>
        <span class="diamond"></span>
        <span class="line"></span>
      </div>
      <h2 class="title">
        <Trans es="Nuestra Historia" en="Our Story" />
      </h2>
      <p class="description">
        <Trans
          es="Desde 2026, LF Steakhouse ha sido un refugio para los amantes de la buena cocina. Fusionamos técnicas contemporáneas con recetas tradicionales, utilizando ingredientes locales de la más alta calidad."
          en="Since 2026, LF Steakhouse has been a haven for lovers of fine dining. We blend contemporary techniques with traditional recipes, using the finest local ingredients."
        />
      </p>
      <p class="description">
        <Trans
          es="Cada plato cuenta una historia, cada visita se convierte en un recuerdo. Te invitamos a ser parte de nuestra familia."
          en="Every dish tells a story, every visit becomes a memory. We invite you to be part of our family."
        />
      </p>
      <div class="stats">
        <div class="stat">
          <span class="stat-number">+5</span>
          <span class="stat-label">
            <Trans es="Años de experiencia" en="Years of experience" />
          </span>
        </div>
        <div class="stat">
          <span class="stat-number">+50</span>
          <span class="stat-label">
            <Trans es="Platos de autor" en="Signature dishes" />
          </span>
        </div>
        <div class="stat">
          <span class="stat-number">10k</span>
          <span class="stat-label">
            <Trans es="Clientes felices" en="Happy guests" />
          </span>
        </div>
      </div>
    </div>
    <div class="image-container">
      <div class="image-frame">
        <div class="image-placeholder">
          <Image
            src={copaImg}
            alt="Copa de vino en LF Steakhouse"
            class="about-image"
            width={450}
            height={562}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: 80px 20px;
    background-color: var(--burgundy);
  }

  @media (min-width: 768px) {
    .about {
      padding: 120px 40px;
    }
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .container {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }
  }

  .ornament {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .ornament .line {
    width: 30px;
    height: 1px;
    background-color: rgba(245, 230, 200, 0.3);
  }

  .ornament .diamond {
    width: 6px;
    height: 6px;
    background-color: rgba(245, 230, 200, 0.4);
    transform: rotate(45deg);
  }

  .title {
    font-family: "Cormorant Garamond", serif;
    font-size: 36px;
    font-weight: 600;
    color: var(--cream);
    letter-spacing: 2px;
    margin-bottom: 24px;
  }

  @media (min-width: 768px) {
    .title {
      font-size: 44px;
    }
  }

  .description {
    font-family: "Montserrat", sans-serif;
    font-size: 15px;
    font-weight: 300;
    color: rgba(245, 230, 200, 0.95);
    line-height: 1.8;
    margin-bottom: 20px;
  }

  .stats {
    display: flex;
    gap: 32px;
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid rgba(245, 230, 200, 0.15);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-number {
    font-family: "Cormorant Garamond", serif;
    font-size: 32px;
    font-weight: 600;
    color: var(--cream);
  }

  .stat-label {
    font-family: "Montserrat", sans-serif;
    font-size: 11px;
    font-weight: 400;
    color: rgba(245, 230, 200, 0.85);
    letter-spacing: 0.5px;
  }

  .image-container {
    display: flex;
    justify-content: center;
  }

  .image-frame {
    position: relative;
    width: 100%;
    max-width: 450px;
  }

  .image-frame::before {
    content: "";
    position: absolute;
    inset: -12px;
    border: 1px solid rgba(245, 230, 200, 0.2);
    pointer-events: none;
  }

  .image-placeholder {
    aspect-ratio: 4/5;
    background: linear-gradient(
      135deg,
      var(--burgundy-light) 0%,
      var(--burgundy-dark) 100%
    );
  }

  .about-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
