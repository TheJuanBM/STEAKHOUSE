---
<div class="lang-switcher" id="lang-switcher">
  <button class="lang-btn" data-lang="es" aria-label="Español">ES</button>
  <span class="lang-sep" aria-hidden="true"></span>
  <button class="lang-btn" data-lang="en" aria-label="English">EN</button>
</div>

<style>
  .lang-switcher {
    display: flex;
    align-items: center;
    background-color: #3d1f1f;
    border-radius: 4px;
    padding: 2px 0;
  }

  .lang-btn {
    font-family: "Montserrat", sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(245, 230, 200, 0.75);
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px 8px;
    transition: color 0.2s ease;
    line-height: 1;
  }

  .lang-btn:hover {
    color: rgba(245, 230, 200, 0.7);
  }

  .lang-btn.active {
    color: #f5e6c8;
  }

  .lang-sep {
    display: block;
    width: 1px;
    height: 11px;
    background-color: rgba(245, 230, 200, 0.2);
    flex-shrink: 0;
  }
</style>

<script>
  function initLangSwitcher() {
    const html = document.documentElement;

    document.querySelectorAll<HTMLButtonElement>(".lang-btn[data-lang]").forEach((btn) => {
      const lang = btn.dataset.lang!;
      btn.classList.toggle("active", lang === (html.getAttribute("lang") || "es"));

      const newBtn = btn.cloneNode(true) as HTMLButtonElement;
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener("click", () => {
        const newLang = newBtn.dataset.lang!;
        localStorage.setItem("lf-lang", newLang);
        html.setAttribute("lang", newLang);
        document.querySelectorAll<HTMLButtonElement>(".lang-btn[data-lang]").forEach((b) => {
          b.classList.toggle("active", b.dataset.lang === newLang);
        });
      });
    });
  }

  initLangSwitcher();
  document.addEventListener("astro:after-swap", initLangSwitcher);
</script>
