---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Trans from '../../i18n/Trans.astro';

const posts = await getCollection('blog');
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Guías ricas (.astro) que no están en la colección pero deben aparecer en el listing
const staticGuides = [
  {
    slug: 'que-hacer-en-caucasia',
    title: 'Guía de Viaje: Qué Hacer en Caucasia, Antioquia',
    description: 'Descubre los mejores lugares, actividades, gastronomía y consejos para visitar Caucasia, la capital del Bajo Cauca antioqueño. Guía completa 2026.',
    date: new Date('2026-04-27'),
  },
];

const fmt = (d: Date) =>
  d.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout
  title="Blog | LF Steakhouse — Gastronomía y Parrilla en Caucasia"
  description="Artículos sobre cortes de carne, coctelería artesanal y gastronomía de LF Steakhouse en Caucasia, Antioquia. Todo sobre la cultura de la parrilla en el Bajo Cauca."
>
  <Header currentPage="/blog" />
  <main>
    <section class="hero">
      <div class="ornament">
        <span class="line"></span>
        <span class="diamond"></span>
        <span class="line"></span>
      </div>
      <h1 class="title">
        <Trans es="Blog" en="Blog" />
      </h1>
      <p class="subtitle">
        <Trans
          es="Gastronomía, parrilla y vida en Caucasia"
          en="Gastronomy, grill and life in Caucasia"
        />
      </p>
    </section>

    <section class="posts">
      {staticGuides.map((guide) => (
        <article class="card">
          <time class="date" datetime={guide.date.toISOString()}>
            {fmt(guide.date)}
          </time>
          <h2 class="card-title">
            <a href={`/blog/${guide.slug}`}>{guide.title}</a>
          </h2>
          <p class="card-desc">{guide.description}</p>
          <a href={`/blog/${guide.slug}`} class="read-more">
            <Trans es="Leer artículo" en="Read article" />
            <span aria-hidden="true"> →</span>
          </a>
        </article>
      ))}
      {sorted.map((post) => (
        <article class="card">
          <time class="date" datetime={post.data.date.toISOString()}>
            {fmt(post.data.date)}
          </time>
          <h2 class="card-title">
            <a href={`/blog/${post.id.replace(/\.md$/, "")}`}>{post.data.title}</a>
          </h2>
          <p class="card-desc">{post.data.description}</p>
          <a href={`/blog/${post.id.replace(/\.md$/, "")}`} class="read-more">
            <Trans es="Leer artículo" en="Read article" />
            <span aria-hidden="true"> →</span>
          </a>
        </article>
      ))}
    </section>

    <div class="back">
      <a href="/" class="back-link">
        <Trans es="← Volver al inicio" en="← Back to home" />
      </a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  main {
    padding-top: var(--header-height, 90px);
    min-height: 100vh;
  }

  .hero {
    text-align: center;
    padding: 60px 20px 48px;
  }

  @media (min-width: 768px) {
    .hero {
      padding: 80px 40px 60px;
    }
  }

  .ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .ornament .line {
    width: 30px;
    height: 1px;
    background-color: rgba(245, 230, 200, 0.3);
  }

  .ornament .diamond {
    width: 6px;
    height: 6px;
    background-color: rgba(245, 230, 200, 0.4);
    transform: rotate(45deg);
  }

  .title {
    font-family: "Cormorant Garamond", serif;
    font-size: 44px;
    font-weight: 600;
    color: #f5e6c8;
    letter-spacing: 4px;
    margin-bottom: 12px;
  }

  @media (min-width: 768px) {
    .title {
      font-size: 56px;
    }
  }

  .subtitle {
    font-family: "Montserrat", sans-serif;
    font-size: 12px;
    font-weight: 300;
    color: rgba(245, 230, 200, 0.55);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .posts {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 20px 80px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  @media (min-width: 768px) {
    .posts {
      padding: 0 40px 100px;
    }
  }

  .card {
    padding: 36px 0;
    border-bottom: 1px solid rgba(245, 230, 200, 0.1);
  }

  .card:first-child {
    border-top: 1px solid rgba(245, 230, 200, 0.1);
  }

  .date {
    display: block;
    font-family: "Montserrat", sans-serif;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  color: rgba(245, 230, 200, 0.6);
    margin-bottom: 12px;
  }

  .card-title {
    font-family: "Cormorant Garamond", serif;
    font-size: 26px;
    font-weight: 600;
    color: #f5e6c8;
    margin-bottom: 12px;
    line-height: 1.3;
  }

  @media (min-width: 640px) {
    .card-title {
      font-size: 32px;
    }
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .card-title a:hover {
    opacity: 0.75;
  }

  .card-desc {
    font-family: "Montserrat", sans-serif;
    font-size: 14px;
    font-weight: 300;
    color: rgba(245, 230, 200, 0.65);
    line-height: 1.7;
    margin-bottom: 20px;
    max-width: 560px;
  }

  .read-more {
    font-family: "Montserrat", sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(245, 230, 200, 0.7);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .read-more:hover {
    color: #f5e6c8;
  }

  .back {
    text-align: center;
    padding-bottom: 60px;
  }

  .back-link {
    font-family: "Montserrat", sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
  color: rgba(245, 230, 200, 0.6);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: rgba(245, 230, 200, 0.7);
  }
</style>
