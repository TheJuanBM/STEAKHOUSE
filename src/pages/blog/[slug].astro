---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Trans from '../../i18n/Trans.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const baseUrl = Astro.site?.toString() ?? 'https://lfsteakhouse.com';

const fmt = (d: Date) =>
  d.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  url: `${baseUrl}/blog/${post.id.replace(/\.md$/, "")}`,
  author: {
    '@type': 'Organization',
    name: 'LF Steakhouse',
    url: baseUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'LF Steakhouse',
    url: baseUrl,
    logo: { '@type': 'ImageObject', url: `${baseUrl}/logo.jpg` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${baseUrl}/blog/${post.id.replace(/\.md$/, "")}` },
  isPartOf: { '@type': 'Blog', '@id': `${baseUrl}/blog` },
};
---

<Layout
  title={`${post.data.title} | LF Steakhouse`}
  description={post.data.description}
  keywords={post.data.keywords}
>
  <Header currentPage="/blog" />
  <main>
    <article>
      <header class="post-header">
        <nav class="breadcrumb" aria-label="breadcrumb">
          <a href="/">
            <Trans es="Inicio" en="Home" />
          </a>
          <span aria-hidden="true"> / </span>
          <a href="/blog">Blog</a>
          <span aria-hidden="true"> / </span>
          <span aria-current="page">{post.data.title}</span>
        </nav>
        <time class="date" datetime={post.data.date.toISOString()}>
          {fmt(post.data.date)}
        </time>
        <h1 class="title">{post.data.title}</h1>
        <p class="lead">{post.data.description}</p>
        <div class="divider"></div>
      </header>

      <div class="content">
        <Content />
      </div>
    </article>

    <section class="cta-bar">
      <a href="/reservar" class="btn btn-primary">
        <Trans es="Reservar Mesa" en="Reserve a Table" />
      </a>
      <a href="/menu" class="btn btn-secondary">
        <Trans es="Ver Menú" en="View Menu" />
      </a>
    </section>

    <div class="back">
      <a href="/blog" class="back-link">
        <Trans es="← Todos los artículos" en="← All articles" />
      </a>
    </div>
  </main>
  <Footer />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>

<style>
  main {
    padding-top: var(--header-height, 90px);
    min-height: 100vh;
  }

  article {
    max-width: 680px;
    margin: 0 auto;
    padding: 48px 20px 0;
  }

  @media (min-width: 768px) {
    article {
      padding: 64px 40px 0;
    }
  }

  /* Breadcrumb */
  .breadcrumb {
    font-family: "Montserrat", sans-serif;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: rgba(245, 230, 200, 0.35);
    margin-bottom: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }

  .breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: rgba(245, 230, 200, 0.65);
  }

  .breadcrumb [aria-current="page"] {
    color: rgba(245, 230, 200, 0.55);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 200px;
  }

  /* Post header */
  .date {
    display: block;
    font-family: "Montserrat", sans-serif;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(245, 230, 200, 0.4);
    margin-bottom: 16px;
  }

  .title {
    font-family: "Cormorant Garamond", serif;
    font-size: 36px;
    font-weight: 600;
    color: var(--cream);
    line-height: 1.2;
    letter-spacing: 1px;
    margin-bottom: 16px;
  }

  @media (min-width: 640px) {
    .title {
      font-size: 48px;
    }
  }

  .lead {
    font-family: "Montserrat", sans-serif;
    font-size: 15px;
    font-weight: 300;
    color: rgba(245, 230, 200, 0.6);
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .divider {
    height: 1px;
    background-color: rgba(245, 230, 200, 0.12);
    margin-bottom: 40px;
  }

  /* Article content */
  .content {
    font-family: "Montserrat", sans-serif;
    font-size: 15px;
    font-weight: 300;
    color: rgba(245, 230, 200, 0.85);
    line-height: 1.85;
  }

  .content :global(h2) {
    font-family: "Cormorant Garamond", serif;
    font-size: 28px;
    font-weight: 600;
    color: var(--cream);
    letter-spacing: 1px;
    margin: 48px 0 16px;
  }

  .content :global(h3) {
    font-family: "Cormorant Garamond", serif;
    font-size: 22px;
    font-weight: 500;
    color: var(--cream);
    margin: 32px 0 12px;
  }

  .content :global(p) {
    margin-bottom: 20px;
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: 20px;
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .content :global(li) {
    color: rgba(245, 230, 200, 0.8);
  }

  .content :global(strong) {
    font-weight: 500;
    color: var(--cream);
  }

  .content :global(a) {
    color: var(--cream);
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .content :global(a:hover) {
    opacity: 0.7;
  }

  .content :global(hr) {
    border: none;
    border-top: 1px solid rgba(245, 230, 200, 0.12);
    margin: 40px 0;
  }

  /* CTA bar */
  .cta-bar {
    max-width: 680px;
    margin: 60px auto 0;
    padding: 40px 20px;
    border-top: 1px solid rgba(245, 230, 200, 0.12);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  @media (min-width: 480px) {
    .cta-bar {
      flex-direction: row;
      justify-content: center;
      padding: 40px 40px;
    }
  }

  .btn {
    font-family: "Montserrat", sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 16px 36px;
    transition: all 0.3s ease;
    width: 100%;
    text-align: center;
  }

  @media (min-width: 480px) {
    .btn {
      width: auto;
    }
  }

  .btn-primary {
    background-color: var(--cream);
    color: var(--burgundy);
  }

  .btn-primary:hover {
    background-color: var(--cream-light);
    transform: translateY(-2px);
  }

  .btn-secondary {
    color: var(--cream);
    border: 1px solid rgba(245, 230, 200, 0.35);
  }

  .btn-secondary:hover {
    border-color: var(--cream);
    background-color: rgba(245, 230, 200, 0.06);
  }

  /* Back link */
  .back {
    text-align: center;
    padding: 32px 20px 80px;
  }

  .back-link {
    font-family: "Montserrat", sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: rgba(245, 230, 200, 0.35);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: rgba(245, 230, 200, 0.65);
  }
</style>
