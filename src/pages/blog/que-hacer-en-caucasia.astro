---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Trans from "../../i18n/Trans.astro";

const baseUrl = Astro.site?.toString() ?? "https://lfsteakhouse.com";

// ── Bilingual content ────────────────────────────────────────────────────────

const facts = [
  { value: "~100k", es: "Habitantes", en: "Inhabitants" },
  { value: "30-33°C", es: "Temperatura", en: "Temperature" },
  { value: "~5 h", es: "Desde Medellín", en: "From Medellín" },
  { value: "50 msnm", es: "Altitud", en: "Altitude" },
];

const toc = [
  {
    href: "#sobre-caucasia",
    es: "01 · Sobre Caucasia",
    en: "01 · About Caucasia",
  },
  { href: "#como-llegar", es: "02 · Cómo Llegar", en: "02 · How to Get There" },
  { href: "#que-hacer", es: "03 · Qué Hacer", en: "03 · What to Do" },
  { href: "#gastronomia", es: "04 · Gastronomía", en: "04 · Gastronomy" },
  { href: "#festividades", es: "05 · Festividades", en: "05 · Festivities" },
  { href: "#consejos", es: "06 · Consejos de Viaje", en: "06 · Travel Tips" },
];

const infoCards = [
  {
    es: {
      title: "Economía",
      text: "Ganadería, minería de oro, comercio y agroindustria son los pilares económicos del Bajo Cauca.",
    },
    en: {
      title: "Economy",
      text: "Cattle farming, gold mining, commerce and agro-industry are the economic pillars of Bajo Cauca.",
    },
  },
  {
    es: {
      title: "Zona horaria",
      text: "UTC-5 (hora Colombia). El sol sale alrededor de las 6:00 am y cae a las 6:00 pm todo el año.",
    },
    en: {
      title: "Time Zone",
      text: "UTC-5 (Colombia time). Sunrise is around 6:00 am and sunset at 6:00 pm year-round.",
    },
  },
  {
    es: {
      title: "Ubicación",
      text: "Km 3 vía a la Costa, a orillas del río Cauca, en el límite norte de Antioquia con Córdoba y Bolívar.",
    },
    en: {
      title: "Location",
      text: "Km 3 on the coastal road, on the banks of the Cauca River, at the northern border of Antioquia with Córdoba and Bolívar.",
    },
  },
];

const routes = [
  {
    es: {
      title: "Desde Medellín",
      text: "~5 horas por la Troncal del Norte (vía Yarumal). Salidas frecuentes desde el Terminal del Norte. Hay buses Rápido Ochoa, Brasilia y Flota Magdalena.",
    },
    en: {
      title: "From Medellín",
      text: "~5 hours via the Troncal del Norte (through Yarumal). Frequent departures from the North Bus Terminal. Rápido Ochoa, Brasilia and Flota Magdalena buses available.",
    },
  },
  {
    es: {
      title: "Desde la Costa Caribe",
      text: "Desde Montería ~2.5 h, desde Barranquilla ~6 h por la Troncal de Occidente. Conexión directa con Sucre y Bolívar.",
    },
    en: {
      title: "From the Caribbean Coast",
      text: "From Montería ~2.5 h, from Barranquilla ~6 h via the Troncal de Occidente. Direct connection with Sucre and Bolívar.",
    },
  },
  {
    es: {
      title: "En carro particular",
      text: "La doble calzada Medellín-Caucasia está parcialmente lista. Peajes en Yarumal y Santa Rosa de Osos. Se recomienda salir antes de las 6 am para evitar tráfico en Yarumal.",
    },
    en: {
      title: "By Private Car",
      text: "The Medellín-Caucasia dual carriageway is partially complete. Tolls at Yarumal and Santa Rosa de Osos. We recommend leaving before 6 am to avoid traffic in Yarumal.",
    },
  },
];

const activities = [
  {
    es: {
      title: "Río Cauca",
      text: "El río es el alma de Caucasia. Paseos en lancha, pesca deportiva y los atardeceres sobre el agua son experiencias únicas que solo encuentras aquí. El Malecón del Río es el punto de encuentro local al final de la tarde.",
    },
    en: {
      title: "Cauca River",
      text: "The river is the soul of Caucasia. Boat rides, sport fishing and sunsets over the water are unique experiences you can only find here. The riverside promenade is the local meeting point at the end of the afternoon.",
    },
  },
  {
    es: {
      title: "Centro Histórico",
      text: "El parque principal y la Catedral de Nuestra Señora de las Mercedes concentran la vida cultural y religiosa de la ciudad. Los domingos el parque se llena de familias y vendedores de frutas locales.",
    },
    en: {
      title: "Historic Center",
      text: "The main square and the Cathedral of Our Lady of Mercy are the heart of the city's cultural and religious life. On Sundays the square fills with families and local fruit vendors.",
    },
  },
  {
    es: {
      title: "Avistamiento de Aves",
      text: "La región del Bajo Cauca es un corredor natural para aves migratorias y endémicas. La ribera del río y los bosques de galería alrededor de Caucasia son ideales para birdwatching.",
    },
    en: {
      title: "Birdwatching",
      text: "The Bajo Cauca region is a natural corridor for migratory and endemic birds. The riverbank and gallery forests around Caucasia are ideal for birdwatching.",
    },
  },
  {
    es: {
      title: "Turismo Rural",
      text: "Las fincas ganaderas de los alrededores ofrecen experiencias auténticas de campo: ordeño, caminatas ecológicas y la posibilidad de probar quesos y derivados lácteos directamente de la fuente.",
    },
    en: {
      title: "Rural Tourism",
      text: "The surrounding cattle farms offer authentic countryside experiences: milking, nature walks and the chance to taste cheeses and dairy products straight from the source.",
    },
  },
  {
    es: {
      title: "Parque Lineal",
      text: "El paseo peatonal sobre la ribera del río es uno de los proyectos de renovación urbana más recientes de Caucasia. Perfecto para correr, caminar o simplemente disfrutar la brisa del río al amanecer.",
    },
    en: {
      title: "Linear Park",
      text: "The riverside pedestrian walkway is one of Caucasia's most recent urban renewal projects. Perfect for running, walking or simply enjoying the river breeze at dawn.",
    },
  },
  {
    es: {
      title: "Comercio Local",
      text: "Caucasia es el principal centro comercial del Bajo Cauca. Sus galerías, mercado de frutas y tiendas de artesanías locales son una ventana a la vida cotidiana de la región.",
    },
    en: {
      title: "Local Commerce",
      text: "Caucasia is the main commercial hub of Bajo Cauca. Its galleries, fruit market and local craft shops offer a window into the daily life of the region.",
    },
  },
];

const foods = [
  {
    es: {
      name: "Mojarra frita",
      desc: "Pescado de río frito entero, acompañado de patacón pisado, arroz con coco y ensalada. El plato más popular del Bajo Cauca.",
    },
    en: {
      name: "Fried mojarra",
      desc: "Whole fried river fish, served with smashed patacón, coconut rice and salad. The most popular dish in Bajo Cauca.",
    },
  },
  {
    es: {
      name: "Bandeja paisa ribereña",
      desc: "Variación local de la bandeja tradicional, con chicharrón, frijoles, carne molida, arepa, aguacate y arroz blanco.",
    },
    en: {
      name: "Riverside bandeja paisa",
      desc: "Local variation of the traditional bandeja, with chicharrón, beans, ground beef, arepa, avocado and white rice.",
    },
  },
  {
    es: {
      name: "Suero costeño",
      desc: "Crema de leche fermentada, herencia caribeña que se sirve con todo: arepas, patacones y carnes.",
    },
    en: {
      name: "Caribbean suero",
      desc: "Fermented cream with Caribbean roots, served with everything: arepas, patacones and meats.",
    },
  },
  {
    es: {
      name: "Corozo",
      desc: "Fruta silvestre de la región que se usa en jugos, raspadillas y cócteles. Tiene un sabor ácido y tropical único del Bajo Cauca.",
    },
    en: {
      name: "Corozo berry",
      desc: "Wild regional fruit used in juices, shaved ice and cocktails. It has a tart, tropical flavor unique to Bajo Cauca.",
    },
  },
];

const events = [
  {
    month: "Jul - Ago",
    es: {
      name: "Fiestas del Río Cauca",
      desc: "La celebración más importante del año. Reinado del Río, regatas, conciertos y desfiles convierten a Caucasia en el epicentro cultural del Bajo Cauca durante varias semanas.",
    },
    en: {
      name: "Cauca River Festival",
      desc: "The most important celebration of the year. River Queen pageant, regattas, concerts and parades turn Caucasia into the cultural epicenter of Bajo Cauca for several weeks.",
    },
  },
  {
    month: "Oct",
    es: {
      name: "Feria Ganadera y Agropecuaria",
      desc: "Exposición de razas bovinas, muestra comercial y concursos que reflejan la identidad ganadera de la región. Una ventana al campo del Bajo Cauca.",
    },
    en: {
      name: "Livestock and Agricultural Fair",
      desc: "Exhibition of bovine breeds, commercial showcase and contests reflecting the cattle identity of the region. A window into the Bajo Cauca countryside.",
    },
  },
  {
    month: "Dic",
    es: {
      name: "Temporada Decembrina",
      desc: "El parque principal se ilumina y las calles se llenan de música vallenata y champeta. La temporada más animada para visitar la ciudad.",
    },
    en: {
      name: "Holiday Season",
      desc: "The main square lights up and the streets fill with vallenato and champeta music. The most lively time of year to visit the city.",
    },
  },
];

const tips = [
  {
    es: {
      title: "Mejor época",
      text: "Diciembre-marzo es temporada seca. Abril-noviembre es más lluvioso pero el paisaje es más verde y el río más caudaloso.",
    },
    en: {
      title: "Best Time to Visit",
      text: "December-March is dry season. April-November is rainier but the landscape is greener and the river fuller.",
    },
  },
  {
    es: {
      title: "Qué empacar",
      text: "Ropa ligera y de colores claros, protector solar alto, repelente de insectos, sombrero y calzado cómodo para caminar.",
    },
    en: {
      title: "What to Pack",
      text: "Light, light-colored clothing, high-SPF sunscreen, insect repellent, a hat and comfortable walking shoes.",
    },
  },
  {
    es: {
      title: "Dinero",
      text: "Hay cajeros Bancolombia, Davivienda y Nequi en el centro. La mayoría de restaurantes y comercios aceptan tarjetas, aunque en plazas de mercado se prefiere efectivo.",
    },
    en: {
      title: "Money",
      text: "Bancolombia, Davivienda and Nequi ATMs are available downtown. Most restaurants and shops accept cards, though cash is preferred in markets.",
    },
  },
  {
    es: {
      title: "Conectividad",
      text: "Claro, Movistar y Tigo tienen cobertura en el área urbana. El internet 4G/5G es estable en el centro. Zonas rurales pueden tener señal limitada.",
    },
    en: {
      title: "Connectivity",
      text: "Claro, Movistar and Tigo have coverage in the urban area. 4G/5G is stable downtown. Rural areas may have limited signal.",
    },
  },
  {
    es: {
      title: "Salud",
      text: "Usa repelente — hay presencia de mosquitos cerca del río. El Hospital La Apartada atiende urgencias. Se recomienda vacuna de hepatitis A para viajeros.",
    },
    en: {
      title: "Health",
      text: "Use insect repellent — mosquitoes are common near the river. Hospital La Apartada handles emergencies. Hepatitis A vaccine is recommended for travelers.",
    },
  },
  {
    es: {
      title: "Transporte local",
      text: "Mototaxis y taxis son los medios más comunes. Negocia la tarifa antes de subir. Para el Km 3 (LF Steakhouse), cualquier mototaxi del centro te lleva en 10 min.",
    },
    en: {
      title: "Local Transport",
      text: "Motorbike taxis and taxis are the most common options. Agree on the fare before boarding. To reach Km 3 (LF Steakhouse), any downtown motorbike taxi gets you there in 10 min.",
    },
  },
];

// ── JSON-LD ──────────────────────────────────────────────────────────────────
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Guía de Viaje: Qué Hacer en Caucasia, Antioquia",
  description:
    "Descubre los mejores lugares, actividades, gastronomía y consejos para visitar Caucasia, la capital del Bajo Cauca antioqueño.",
  datePublished: "2026-04-27T00:00:00Z",
  dateModified: "2026-04-27T00:00:00Z",
  url: `${baseUrl}/blog/que-hacer-en-caucasia`,
  author: { "@type": "Organization", name: "LF Steakhouse", url: baseUrl },
  publisher: {
    "@type": "Organization",
    name: "LF Steakhouse",
    url: baseUrl,
    logo: { "@type": "ImageObject", url: `${baseUrl}/logo.jpg` },
  },
  about: {
    "@type": "TouristDestination",
    name: "Caucasia, Antioquia, Colombia",
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `${baseUrl}/blog/que-hacer-en-caucasia`,
  },
};

// SVG icons reused across cards
const iconMap: Record<string, string> = {
  economy:
    '<path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  clock:
    '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  pin: '<path d="M12 22s-8-4.5-8-11.8A8 8 0 0112 2a8 8 0 018 8.2c0 7.3-8 11.8-8 11.8z"/><circle cx="12" cy="10" r="3"/>',
  bus: '<rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>',
  box: '<path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>',
  card: '<rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/>',
  phone:
    '<rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>',
  health:
    '<path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>',
  info: '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>',
};

const infoCardIcons = ["economy", "clock", "pin"];
const routeIcons = ["bus", "bus", "box"];
const tipIcons = ["pin", "health", "card", "phone", "health", "bus"];
---

<Layout
  title="Guía de Viaje: Qué Hacer en Caucasia, Antioquia | LF Steakhouse"
  description="Descubre los mejores lugares, actividades, gastronomía y consejos para visitar Caucasia, la capital del Bajo Cauca antioqueño. Guía completa 2026."
  keywords="qué hacer en Caucasia, turismo Caucasia Antioquia, visitar Bajo Cauca, Caucasia Colombia, lugares Caucasia"
>
  <Header currentPage="/blog" />

  <main>
    <!-- ── Hero ── -->
    <section class="hero">
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <nav class="breadcrumb" aria-label="breadcrumb">
          <a href="/"><Trans es="Inicio" en="Home" /></a>
          <span aria-hidden="true"> / </span>
          <a href="/blog">Blog</a>
          <span aria-hidden="true"> / </span>
          <span aria-current="page"
            ><Trans es="Guía Caucasia" en="Caucasia Guide" /></span
          >
        </nav>
        <p class="hero-category">
          <Trans es="Guía de Viaje" en="Travel Guide" />
        </p>
        <h1 class="hero-title">
          <Trans
            es="Qué Hacer en Caucasia, Antioquia"
            en="What to Do in Caucasia, Antioquia"
          />
        </h1>
        <p class="hero-subtitle i18n-es">
          La capital del Bajo Cauca: río, cultura ganadera, gastronomía y la
          mejor mesa de la región
        </p>
        <p class="hero-subtitle i18n-en">
          The capital of Bajo Cauca: river, cattle culture, gastronomy and the
          best table in the region
        </p>
      </div>
      <div class="scroll-hint" aria-hidden="true">
        <span class="scroll-line"></span>
      </div>
    </section>

    <!-- ── Facts bar ── -->
    <section class="facts-bar">
      <div class="facts-inner">
        {
          facts.map((f, i) => (
            <>
              <div class="fact">
                <span class="fact-value">{f.value}</span>
                <span class="fact-label">
                  <Trans es={f.es} en={f.en} />
                </span>
              </div>
              {i < facts.length - 1 && <div class="fact-divider" />}
            </>
          ))
        }
      </div>
    </section>

    <!-- ── Table of contents ── -->
    <section class="toc-section">
      <details class="toc" open>
        <summary class="toc-title">
          <span><Trans es="Contenido" en="Contents" /></span>
          <svg
            class="toc-arrow"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg
          >
        </summary>
        <nav class="toc-grid">
          {
            toc.map((item) => (
              <a href={item.href}>
                <Trans es={item.es} en={item.en} />
              </a>
            ))
          }
        </nav>
      </details>
    </section>

    <!-- ── 01 Sobre Caucasia ── -->
    <section id="sobre-caucasia" class="content-section">
      <div class="section-inner">
        <div class="section-label">01</div>
        <h2 class="section-title">
          <Trans es="Sobre Caucasia" en="About Caucasia" />
        </h2>
        <p class="section-text i18n-es">
          Caucasia es la capital de la subregión del Bajo Cauca antioqueño y uno
          de los centros económicos más importantes del norte de Colombia.
          Ubicada a orillas del río Cauca, la ciudad concentra el comercio, la
          gastronomía y la cultura ganadera de toda la región.
        </p>
        <p class="section-text i18n-en">
          Caucasia is the capital of the Bajo Cauca Antioqueño subregion and one
          of the most important economic centers in northern Colombia. Located
          on the banks of the Cauca River, the city concentrates the commerce,
          gastronomy and cattle culture of the entire region.
        </p>
        <p class="section-text i18n-es">
          Con una población de cerca de 100.000 habitantes y un clima cálido que
          ronda los 30-33°C todo el año, Caucasia es una ciudad de paso obligado
          para quienes viajan entre Medellín, la Costa Caribe y el Urabá
          antioqueño.
        </p>
        <p class="section-text i18n-en">
          With a population of around 100,000 inhabitants and a warm climate of
          30-33°C year-round, Caucasia is a mandatory stop for those traveling
          between Medellín, the Caribbean Coast and Urabá antioqueño.
        </p>
        <div class="cards-grid">
          {
            infoCards.map((card, i) => (
              <div class="info-card">
                <div class="info-card-icon">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    set:html={iconMap[infoCardIcons[i]]}
                  />
                </div>
                <div>
                  <p class="info-card-title">
                    <Trans es={card.es.title} en={card.en.title} />
                  </p>
                  <p class="info-card-text i18n-es">{card.es.text}</p>
                  <p class="info-card-text i18n-en">{card.en.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── 02 Cómo Llegar ── -->
    <section id="como-llegar" class="content-section alt">
      <div class="section-inner">
        <div class="section-label">02</div>
        <h2 class="section-title">
          <Trans es="Cómo Llegar" en="How to Get There" />
        </h2>
        <p class="section-text i18n-es">
          Caucasia está bien conectada por vía terrestre desde las principales
          ciudades de Colombia. La ruta más usada es la que viene desde Medellín
          pasando por Yarumal y Valdivia.
        </p>
        <p class="section-text i18n-en">
          Caucasia is well connected by road from Colombia's main cities. The
          most used route comes from Medellín via Yarumal and Valdivia.
        </p>
        <div class="route-list">
          {
            routes.map((r, i) => (
              <div class="route-item">
                <div class="route-icon">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    set:html={iconMap[routeIcons[i]]}
                  />
                </div>
                <div>
                  <p class="route-title i18n-es">{r.es.title}</p>
                  <p class="route-title i18n-en">{r.en.title}</p>
                  <p class="route-text i18n-es">{r.es.text}</p>
                  <p class="route-text i18n-en">{r.en.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── 03 Qué Hacer ── -->
    <section id="que-hacer" class="content-section">
      <div class="section-inner">
        <div class="section-label">03</div>
        <h2 class="section-title">
          <Trans es="Qué Hacer en Caucasia" en="What to Do in Caucasia" />
        </h2>
        <p class="section-text i18n-es">
          Caucasia ofrece una combinación de naturaleza, cultura y la calidez
          característica del Bajo Cauca. Estas son las actividades
          imprescindibles:
        </p>
        <p class="section-text i18n-en">
          Caucasia offers a blend of nature, culture and the warmth
          characteristic of Bajo Cauca. These are the must-do activities:
        </p>
        <div class="activities-grid">
          {
            activities.map((a) => (
              <div class="activity-card">
                <h3 class="activity-title">
                  <Trans es={a.es.title} en={a.en.title} />
                </h3>
                <p class="activity-text i18n-es">{a.es.text}</p>
                <p class="activity-text i18n-en">{a.en.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── 04 Gastronomía ── -->
    <section id="gastronomia" class="content-section alt">
      <div class="section-inner">
        <div class="section-label">04</div>
        <h2 class="section-title">
          <Trans es="Gastronomía en Caucasia" en="Gastronomy in Caucasia" />
        </h2>
        <p class="section-text i18n-es">
          La mesa caucasiana mezcla la cocina paisa con sabores caribeños y la
          tradición ganadera del Bajo Cauca. El pescado de río, la carne a la
          brasa y los patacones son protagonistas.
        </p>
        <p class="section-text i18n-en">
          Caucasian cuisine blends paisa cooking with Caribbean flavors and the
          cattle tradition of Bajo Cauca. River fish, grilled meat and patacones
          take center stage.
        </p>

        <div class="featured-restaurant">
          <div class="featured-badge">
            <Trans es="Recomendado" en="Recommended" />
          </div>
          <h3 class="featured-title">LF Steakhouse</h3>
          <p class="featured-text i18n-es">
