---
import { Image, getImage } from "astro:assets";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Trans from "../i18n/Trans.astro";
import Layout from "../layouts/Layout.astro";

import imgAmbiente1 from "../assets/ambiente-1.png";
import imgAmbiente2 from "../assets/ambiente-2.png";
import imgAmbiente3 from "../assets/ambiente-3.png";
import imgEmpanadas from "../assets/empanadas.jpg";
import imgEvento1 from "../assets/evento-1.png";
import imgEvento2 from "../assets/evento-2.png";
import imgEvento3 from "../assets/evento-3.png";
import imgEvento4 from "../assets/evento-4.png";
import imgEvento5 from "../assets/evento-5.png";
import imgMargarita from "../assets/margarita.jpg";
import imgMazorquitas from "../assets/mazorquitas.jpg";
import imgMolcajete from "../assets/molcajete.jpg";

const images = [
  {
    src: imgEmpanadas,
    alt: "Empanadas de la casa",
    altEn: "House empanadas",
    category: "carta",
    categoryLabel: "Carta",
    categoryLabelEn: "Menu",
  },
  {
    src: imgMazorquitas,
    alt: "Mazorquitas a la brasa",
    altEn: "Grilled baby corn",
    category: "carta",
    categoryLabel: "Carta",
    categoryLabelEn: "Menu",
  },
  {
    src: imgMolcajete,
    alt: "Molcajete especial LF",
    altEn: "LF Special molcajete",
    category: "carta",
    categoryLabel: "Carta",
    categoryLabelEn: "Menu",
  },
  {
    src: imgMargarita,
    alt: "Margarita de frutos rojos con borde de tajín",
    altEn: "Red berry margarita with tajín rim",
    category: "carta",
    categoryLabel: "Carta",
    categoryLabelEn: "Menu",
  },
  {
    src: imgEvento1,
    alt: "Cantante en vivo en LF Steakhouse",
    altEn: "Live singer at LF Steakhouse",
    category: "eventos",
    categoryLabel: "Eventos",
    categoryLabelEn: "Events",
  },
  {
    src: imgEvento2,
    alt: "Banda en vivo en LF Steakhouse",
    altEn: "Live band at LF Steakhouse",
    category: "eventos",
    categoryLabel: "Eventos",
    categoryLabelEn: "Events",
  },
  {
    src: imgEvento3,
    alt: "Cumpleaños en LF Steakhouse",
    altEn: "Birthday celebration at LF Steakhouse",
    category: "eventos",
    categoryLabel: "Eventos",
    categoryLabelEn: "Events",
  },
  {
    src: imgEvento4,
    alt: "Celebración entre amigos en LF Steakhouse",
    altEn: "Friends celebration at LF Steakhouse",
    category: "eventos",
    categoryLabel: "Eventos",
    categoryLabelEn: "Events",
  },
  {
    src: imgEvento5,
    alt: "Celebración familiar en LF Steakhouse",
    altEn: "Family celebration at LF Steakhouse",
    category: "eventos",
    categoryLabel: "Eventos",
    categoryLabelEn: "Events",
  },
  {
    src: imgAmbiente1,
    alt: "Stand de licores premium en LF Steakhouse",
    altEn: "Premium liquor stand at LF Steakhouse",
    category: "ambiente",
    categoryLabel: "Ambiente",
    categoryLabelEn: "Ambiance",
  },
  {
    src: imgAmbiente2,
    alt: "Entrada de LF Steakhouse con letrero iluminado",
    altEn: "LF Steakhouse entrance with illuminated sign",
    category: "ambiente",
    categoryLabel: "Ambiente",
    categoryLabelEn: "Ambiance",
  },
  {
    src: imgAmbiente3,
    alt: "Comedor interior de LF Steakhouse",
    altEn: "LF Steakhouse interior dining area",
    category: "ambiente",
    categoryLabel: "Ambiente",
    categoryLabelEn: "Ambiance",
  },
];

const lightboxSrcs = await Promise.all(
  images.map((img) => getImage({ src: img.src, width: 1200, format: "avif" })),
);

const tabs = [
  { id: "all", label: "Todo", labelEn: "All" },
  { id: "carta", label: "Carta", labelEn: "Menu" },
  { id: "ambiente", label: "Ambiente", labelEn: "Ambiance" },
  { id: "eventos", label: "Eventos", labelEn: "Events" },
];
---

<Layout
  title="Galería | LF Steakhouse Caucasia Antioquia"
  description="Descubre el ambiente, los platos y los eventos de LF Steakhouse en Caucasia, Antioquia. Fotos de brasas, cócteles y espacios únicos en el Bajo Cauca."
>
  <Header currentPage="/galeria" />
  <main>
    <section class="galeria">
      <div class="container">
        <div class="header">
          <div class="ornament">
            <span class="line"></span>
            <span class="diamond"></span>
            <span class="line"></span>
          </div>
          <h1 class="title">
            <Trans es="Galería LF Steakhouse" en="LF Steakhouse Gallery" />
          </h1>
          <p class="subtitle">
            <Trans
              es="Descubre nuestra cocina, ambiente y momentos especiales en Caucasia, Antioquia"
              en="Discover our kitchen, atmosphere and special moments in Caucasia, Antioquia"
            />
          </p>
        </div>

        <nav class="tabs">
          {
            tabs.map((tab) => (
              <button
                class={`tab${tab.id === "all" ? " active" : ""}`}
                data-category={tab.id}
              >
                <span class="i18n-es">{tab.label}</span>
                <span class="i18n-en">{tab.labelEn}</span>
              </button>
            ))
          }
        </nav>

        <div class="gallery-grid" id="gallery-grid">
          {
            images.map((img, i) => (
              <div
                class="gallery-item"
                data-category={img.category}
                data-lightbox-src={lightboxSrcs[i].src}
                data-alt-es={img.alt}
                data-alt-en={img.altEn}
              >
                <Image
                  src={img.src}
                  alt={img.alt}
                  width={600}
                  height={600}
                  class="gallery-img"
                  loading={i < 4 ? "eager" : "lazy"}
                  fetchpriority={i < 4 ? "high" : "auto"}
                  format="avif"
                />
                <div class="image-overlay">
                  <span class="overlay-category">
                    <span class="i18n-es">{img.categoryLabel}</span>
                    <span class="i18n-en">{img.categoryLabelEn}</span>
                  </span>
                  <span class="overlay-text">
                    <span class="i18n-es">{img.alt}</span>
                    <span class="i18n-en">{img.altEn}</span>
                  </span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Lightbox -->
    <div
      class="lightbox"
      id="lightbox"
      role="dialog"
      aria-modal="true"
      aria-label="Imagen ampliada"
    >
      <button
        class="lightbox-close"
        id="lightbox-close"
        aria-label="Cerrar / Close"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
      <button
        class="lightbox-nav lightbox-prev"
        id="lightbox-prev"
        aria-label="Anterior / Previous"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>
      <button
        class="lightbox-nav lightbox-next"
        id="lightbox-next"
        aria-label="Siguiente / Next"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </button>
      <div class="lightbox-content" id="lightbox-content">
        <img id="lightbox-img" src="" alt="" class="lightbox-img" />
        <p class="lightbox-caption" id="lightbox-caption"></p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  main {
    padding-top: 80px;
    min-height: 100vh;
  }

  .galeria {
    padding: 40px 20px 80px;
  }

  @media (min-width: 768px) {
    .galeria {
      padding: 60px 40px 100px;
    }
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .header {
    text-align: center;
    margin-bottom: 48px;
  }

  .ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .ornament .line {
    width: 30px;
    height: 1px;
    background-color: rgba(245, 230, 200, 0.3);
  }

  .ornament .diamond {
    width: 6px;
    height: 6px;
    background-color: rgba(245, 230, 200, 0.4);
    transform: rotate(45deg);
  }

  .title {
    font-family: "Cormorant Garamond", serif;
    font-size: 36px;
    font-weight: 600;
    color: #f5e6c8;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  @media (min-width: 768px) {
    .title {
      font-size: 44px;
    }
  }

  .subtitle {
    font-family: "Montserrat", sans-serif;
    font-size: 14px;
    font-weight: 300;
    color: rgba(245, 230, 200, 0.6);
  }

  .tabs {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .tab {
    font-family: "Montserrat", sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: rgba(245, 230, 200, 0.7);
    background: transparent;
    border: 1px solid rgba(245, 230, 200, 0.2);
    padding: 10px 20px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab:hover {
    color: rgba(245, 230, 200, 0.8);
    border-color: rgba(245, 230, 200, 0.4);
  }

  .tab.active {
    color: #3d1f1f;
    background-color: #f5e6c8;
    border-color: #f5e6c8;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  @media (min-width: 600px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }

  @media (min-width: 900px) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
  }

  .gallery-item {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    cursor: pointer;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .gallery-item.hidden {
    display: none;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(45, 23, 23, 0.9) 0%,
      transparent 60%
    );
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 16px;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  @media (hover: hover) {
    .image-overlay {
      opacity: 0;
    }

    .gallery-item:hover {
      transform: scale(1.02);
    }

    .gallery-item:hover .gallery-img {
      transform: scale(1.05);
    }

    .gallery-item:hover .image-overlay {
      opacity: 1;
    }
  }

  .overlay-category {
    font-family: "Montserrat", sans-serif;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: rgba(245, 230, 200, 0.6);
    margin-bottom: 4px;
  }

  .overlay-text {
    font-family: "Cormorant Garamond", serif;
    font-size: 14px;
    font-weight: 500;
    color: #f5e6c8;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background-color: rgba(20, 10, 10, 0.97);
    display: none;
    align-items: center;
    justify-content: center;
  }

  .lightbox.open {
    display: flex;
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    color: rgba(245, 230, 200, 0.7);
    cursor: pointer;
    padding: 8px;
    transition: color 0.2s ease;
    z-index: 10;
  }

  .lightbox-close:hover {
    color: #f5e6c8;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: rgba(245, 230, 200, 0.7);
    cursor: pointer;
    padding: 16px;
    transition: color 0.2s ease;
    z-index: 10;
  }

  .lightbox-nav:hover {
    color: #f5e6c8;
  }

  .lightbox-prev {
    left: 10px;
  }
  .lightbox-next {
    right: 10px;
  }

  @media (min-width: 768px) {
    .lightbox-prev {
      left: 30px;
    }
    .lightbox-next {
      right: 30px;
    }
  }

  .lightbox-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 90vw;
    max-height: 85vh;
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 78vh;
    object-fit: contain;
    border: 1px solid rgba(245, 230, 200, 0.1);
  }

  .lightbox-caption {
    font-family: "Cormorant Garamond", serif;
    font-size: 16px;
    color: rgba(245, 230, 200, 0.6);
    text-align: center;
    margin: 0;
  }
</style>

<script>
  const tabBtns = document.querySelectorAll(".tab");
  const items = document.querySelectorAll<HTMLElement>(".gallery-item");

  tabBtns.forEach((tab) => {
    tab.addEventListener("click", () => {
      const category = tab.getAttribute("data-category");
      tabBtns.forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");
      items.forEach((item) => {
        const itemCategory = item.getAttribute("data-category");
        item.classList.toggle(
          "hidden",
          category !== "all" && itemCategory !== category,
        );
      });
    });
  });

  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById(
    "lightbox-img",
  ) as HTMLImageElement;
  const lightboxCaption = document.getElementById("lightbox-caption");
  const closeBtn = document.getElementById("lightbox-close");
  const prevBtn = document.getElementById("lightbox-prev");
  const nextBtn = document.getElementById("lightbox-next");

  let currentIndex = 0;
  let visibleItems: HTMLElement[] = [];

  function updateVisibleItems() {
    visibleItems = Array.from(items).filter(
      (item) => !item.classList.contains("hidden"),
    );
  }

  function getLang() {
    return document.documentElement.getAttribute("lang") || "es";
  }

  function openLightbox(index: number) {
    updateVisibleItems();
    currentIndex = index;
    showImage(currentIndex);
    lightbox?.classList.add("open");
    document.body.style.overflow = "hidden";
  }

  function showImage(index: number) {
    const item = visibleItems[index];
    const src = item.getAttribute("data-lightbox-src") || "";
    const lang = getLang();
    const alt =
      lang === "en"
        ? item.getAttribute("data-alt-en") || ""
        : item.getAttribute("data-alt-es") || "";
    if (lightboxImg) {
      lightboxImg.src = src;
      lightboxImg.alt = alt;
    }
    if (lightboxCaption) lightboxCaption.textContent = alt;
  }

  function closeLightbox() {
    lightbox?.classList.remove("open");
    document.body.style.overflow = "";
  }

  function showPrev() {
    currentIndex =
      (currentIndex - 1 + visibleItems.length) % visibleItems.length;
    showImage(currentIndex);
  }

  function showNext() {
    currentIndex = (currentIndex + 1) % visibleItems.length;
    showImage(currentIndex);
  }

  items.forEach((item) => {
    item.addEventListener("click", () => {
      updateVisibleItems();
      openLightbox(visibleItems.indexOf(item));
    });
  });

  closeBtn?.addEventListener("click", closeLightbox);
  prevBtn?.addEventListener("click", showPrev);
  nextBtn?.addEventListener("click", showNext);

  document.addEventListener("keydown", (e) => {
    if (!lightbox?.classList.contains("open")) return;
    if (e.key === "Escape") closeLightbox();
    if (e.key === "ArrowLeft") showPrev();
    if (e.key === "ArrowRight") showNext();
  });

  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });
</script>
