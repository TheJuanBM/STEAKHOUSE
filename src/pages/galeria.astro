---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const galleries = [
  {
    category: "Platillos",
    images: [
      { id: 1, alt: "Filete Mignon con salsa de vino tinto" },
      { id: 2, alt: "Tartar de atún fresco" },
      { id: 3, alt: "Risotto de hongos silvestres" },
      { id: 4, alt: "Postre de chocolate" },
      { id: 5, alt: "Carpaccio de res" },
      { id: 6, alt: "Salmón a la parrilla" },
    ],
  },
  {
    category: "Ambiente",
    images: [
      { id: 7, alt: "Interior del restaurante" },
      { id: 8, alt: "Barra de vinos" },
      { id: 9, alt: "Terraza exterior" },
      { id: 10, alt: "Mesa privada" },
    ],
  },
  {
    category: "Eventos",
    images: [
      { id: 11, alt: "Cena privada" },
      { id: 12, alt: "Celebración especial" },
      { id: 13, alt: "Evento corporativo" },
    ],
  },
];
---

<Layout title="Galería - LF Steakhouse">
  <Header currentPage="/galeria" />
  <main>
    <section class="galeria">
      <div class="container">
        <div class="header">
          <div class="ornament">
            <span class="line"></span>
            <span class="diamond"></span>
            <span class="line"></span>
          </div>
          <h1 class="title">Galería</h1>
          <p class="subtitle">
            Descubre nuestra cocina, ambiente y momentos especiales
          </p>
        </div>

        <nav class="tabs">
          <button class="tab active" data-category="all">Todo</button>
          {
            galleries.map((gallery) => (
              <button
                class="tab"
                data-category={gallery.category.toLowerCase()}
              >
                {gallery.category}
              </button>
            ))
          }
        </nav>

        <div class="gallery-grid" id="gallery-grid">
          {
            galleries.map((gallery) =>
              gallery.images.map((image) => (
                <div
                  class="gallery-item"
                  data-category={gallery.category.toLowerCase()}
                  data-id={image.id}
                >
                  <div class="image-placeholder">
                    <span class="placeholder-icon">
                      <svg
                        width="32"
                        height="32"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1"
                      >
                        <rect x="3" y="3" width="18" height="18" rx="2" />
                        <circle cx="8.5" cy="8.5" r="1.5" />
                        <path d="M21 15l-5-5L5 21" />
                      </svg>
                    </span>
                    <span class="placeholder-text">{image.alt}</span>
                  </div>
                  <div class="image-overlay">
                    <span class="overlay-category">{gallery.category}</span>
                    <span class="overlay-text">{image.alt}</span>
                  </div>
                </div>
              )),
            )
          }
        </div>
      </div>
    </section>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox">
      <button class="lightbox-close" id="lightbox-close" aria-label="Cerrar">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
      <button
        class="lightbox-nav lightbox-prev"
        id="lightbox-prev"
        aria-label="Anterior"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>
      <button
        class="lightbox-nav lightbox-next"
        id="lightbox-next"
        aria-label="Siguiente"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </button>
      <div class="lightbox-content" id="lightbox-content">
        <div class="lightbox-placeholder">
          <span class="lightbox-text" id="lightbox-text"></span>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  main {
    padding-top: 80px;
    min-height: 100vh;
  }

  .galeria {
    padding: 40px 20px 80px;
  }

  @media (min-width: 768px) {
    .galeria {
      padding: 60px 40px 100px;
    }
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .header {
    text-align: center;
    margin-bottom: 48px;
  }

  .ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .ornament .line {
    width: 30px;
    height: 1px;
    background-color: rgba(245, 230, 200, 0.3);
  }

  .ornament .diamond {
    width: 6px;
    height: 6px;
    background-color: rgba(245, 230, 200, 0.4);
    transform: rotate(45deg);
  }

  .title {
    font-family: "Cormorant Garamond", serif;
    font-size: 36px;
    font-weight: 600;
    color: var(--cream);
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  @media (min-width: 768px) {
    .title {
      font-size: 44px;
    }
  }

  .subtitle {
    font-family: "Montserrat", sans-serif;
    font-size: 14px;
    font-weight: 300;
    color: rgba(245, 230, 200, 0.6);
  }

  .tabs {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .tab {
    font-family: "Montserrat", sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: rgba(245, 230, 200, 0.7);
    background: transparent;
    border: 1px solid rgba(245, 230, 200, 0.2);
    padding: 10px 20px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab:hover {
    color: rgba(245, 230, 200, 0.8);
    border-color: rgba(245, 230, 200, 0.4);
  }

  .tab.active {
    color: var(--burgundy);
    background-color: var(--cream);
    border-color: var(--cream);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  @media (min-width: 600px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }

  @media (min-width: 900px) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
  }

  .gallery-item {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    cursor: pointer;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .gallery-item.hidden {
    display: none;
  }

  .gallery-item:hover {
    transform: scale(1.02);
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      var(--burgundy-light) 0%,
      var(--burgundy-dark) 100%
    );
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .placeholder-icon {
    color: rgba(245, 230, 200, 0.2);
  }

  .placeholder-text {
    font-family: "Montserrat", sans-serif;
    font-size: 10px;
    color: rgba(245, 230, 200, 0.25);
    text-align: center;
    padding: 0 12px;
    display: none;
  }

  @media (min-width: 600px) {
    .placeholder-text {
      display: block;
    }
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(45, 23, 23, 0.9) 0%,
      transparent 60%
    );
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 16px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .gallery-item:hover .image-overlay {
    opacity: 1;
  }

  .overlay-category {
    font-family: "Montserrat", sans-serif;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: rgba(245, 230, 200, 0.6);
    margin-bottom: 4px;
  }

  .overlay-text {
    font-family: "Cormorant Garamond", serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--cream);
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background-color: rgba(45, 23, 23, 0.97);
    display: none;
    align-items: center;
    justify-content: center;
  }

  .lightbox.open {
    display: flex;
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    color: rgba(245, 230, 200, 0.7);
    cursor: pointer;
    padding: 8px;
    transition: color 0.2s ease;
    z-index: 10;
  }

  .lightbox-close:hover {
    color: var(--cream);
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: rgba(245, 230, 200, 0.7);
    cursor: pointer;
    padding: 16px;
    transition: color 0.2s ease;
    z-index: 10;
  }

  .lightbox-nav:hover {
    color: var(--cream);
  }

  .lightbox-prev {
    left: 10px;
  }

  .lightbox-next {
    right: 10px;
  }

  @media (min-width: 768px) {
    .lightbox-prev {
      left: 30px;
    }
    .lightbox-next {
      right: 30px;
    }
  }

  .lightbox-content {
    max-width: 90vw;
    max-height: 80vh;
  }

  .lightbox-placeholder {
    width: 80vw;
    height: 60vh;
    max-width: 800px;
    background: linear-gradient(
      135deg,
      var(--burgundy-light) 0%,
      var(--burgundy-dark) 100%
    );
    border: 1px solid rgba(245, 230, 200, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-text {
    font-family: "Cormorant Garamond", serif;
    font-size: 24px;
    color: rgba(245, 230, 200, 0.5);
    text-align: center;
    padding: 20px;
  }
</style>

<script>
  // Tab filtering
  const tabs = document.querySelectorAll(".tab");
  const items = document.querySelectorAll(".gallery-item");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const category = tab.getAttribute("data-category");

      tabs.forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");

      items.forEach((item) => {
        const itemCategory = item.getAttribute("data-category");
        if (category === "all" || itemCategory === category) {
          item.classList.remove("hidden");
        } else {
          item.classList.add("hidden");
        }
      });
    });
  });

  // Lightbox
  const lightbox = document.getElementById("lightbox");
  const lightboxText = document.getElementById("lightbox-text");
  const closeBtn = document.getElementById("lightbox-close");
  const prevBtn = document.getElementById("lightbox-prev");
  const nextBtn = document.getElementById("lightbox-next");

  let currentIndex = 0;
  let visibleItems: Element[] = [];

  function updateVisibleItems() {
    visibleItems = Array.from(items).filter(
      (item) => !item.classList.contains("hidden"),
    );
  }

  function openLightbox(index: number) {
    updateVisibleItems();
    currentIndex = index;
    const item = visibleItems[currentIndex];
    const text = item?.querySelector(".overlay-text")?.textContent || "";
    if (lightboxText) lightboxText.textContent = text;
    lightbox?.classList.add("open");
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    lightbox?.classList.remove("open");
    document.body.style.overflow = "";
  }

  function showPrev() {
    currentIndex =
      (currentIndex - 1 + visibleItems.length) % visibleItems.length;
    const item = visibleItems[currentIndex];
    const text = item?.querySelector(".overlay-text")?.textContent || "";
    if (lightboxText) lightboxText.textContent = text;
  }

  function showNext() {
    currentIndex = (currentIndex + 1) % visibleItems.length;
    const item = visibleItems[currentIndex];
    const text = item?.querySelector(".overlay-text")?.textContent || "";
    if (lightboxText) lightboxText.textContent = text;
  }

  items.forEach((item) => {
    item.addEventListener("click", () => {
      updateVisibleItems();
      const index = visibleItems.indexOf(item);
      openLightbox(index);
    });
  });

  closeBtn?.addEventListener("click", closeLightbox);
  prevBtn?.addEventListener("click", showPrev);
  nextBtn?.addEventListener("click", showNext);

  document.addEventListener("keydown", (e) => {
    if (!lightbox?.classList.contains("open")) return;
    if (e.key === "Escape") closeLightbox();
    if (e.key === "ArrowLeft") showPrev();
    if (e.key === "ArrowRight") showNext();
  });

  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });
</script>
