---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Trans from "../i18n/Trans.astro";
---

<Layout
  title="Página no encontrada | LF Steakhouse"
  description="La página que buscas no existe. Regresa al inicio de LF Steakhouse y descubre nuestro menú de carnes y parrilla en Caucasia, Antioquia."
>
  <Header currentPage="" />
  <main class="not-found">
    <div class="container">
      <div class="ornament">
        <span class="line"></span>
        <span class="diamond"></span>
        <span class="line"></span>
      </div>

      <h1 class="error-code">404</h1>

      <div class="content">
        <h2 class="title">
          <Trans es="Página no encontrada" en="Page not found" />
        </h2>
        <p class="description">
          <Trans
            es="Lo sentimos, la página que buscas no existe o ha sido movida. Te invitamos a volver a nuestro restaurante."
            en="We're sorry, the page you're looking for doesn't exist or has been moved. We invite you to return to our restaurant."
          />
        </p>
      </div>

      <div class="actions">
        <a href="/" class="btn btn-primary">
          <Trans es="Volver al inicio" en="Back to home" />
        </a>
        <a href="/menu" class="btn btn-secondary">
          <Trans es="Ver menú" en="View menu" />
        </a>
      </div>

      <div class="ornament bottom">
        <span class="line"></span>
        <span class="diamond"></span>
        <span class="line"></span>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .not-found {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 20px 80px;
    background: linear-gradient(
      180deg,
      var(--burgundy-dark) 0%,
      var(--burgundy) 50%,
      var(--burgundy-dark) 100%
    );
  }

  .container {
    max-width: 600px;
    text-align: center;
  }

  .ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 40px;
  }

  .ornament.bottom {
    margin-top: 50px;
    margin-bottom: 0;
  }

  .ornament .line {
    width: 40px;
    height: 1px;
    background-color: rgba(245, 230, 200, 0.3);
  }

  .ornament .diamond {
    width: 8px;
    height: 8px;
    background-color: rgba(245, 230, 200, 0.4);
    transform: rotate(45deg);
  }

  .error-code {
    font-family: "Cormorant Garamond", serif;
    font-size: 120px;
    font-weight: 600;
    color: var(--cream);
    letter-spacing: 8px;
    line-height: 1;
    margin-bottom: 24px;
    opacity: 0.9;
  }

  @media (min-width: 768px) {
    .error-code {
      font-size: 180px;
      letter-spacing: 12px;
    }
  }

  .content {
    margin-bottom: 40px;
  }

  .title {
    font-family: "Cormorant Garamond", serif;
    font-size: 28px;
    font-weight: 600;
    color: var(--cream);
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  @media (min-width: 768px) {
    .title {
      font-size: 36px;
    }
  }

  .description {
    font-family: "Montserrat", sans-serif;
    font-size: 14px;
    font-weight: 300;
    color: rgba(245, 230, 200, 0.7);
    line-height: 1.8;
    letter-spacing: 0.5px;
    max-width: 450px;
    margin: 0 auto;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
  }

  @media (min-width: 480px) {
    .actions {
      flex-direction: row;
      justify-content: center;
    }
  }

  .btn {
    display: inline-block;
    font-family: "Montserrat", sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 16px 36px;
    transition: all 0.3s ease;
    min-width: 180px;
  }

  .btn-primary {
    background-color: var(--cream);
    color: var(--burgundy);
    border: 1px solid var(--cream);
  }

  .btn-primary:hover {
    background-color: transparent;
    color: var(--cream);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--cream);
    border: 1px solid rgba(245, 230, 200, 0.4);
  }

  .btn-secondary:hover {
    background-color: var(--cream);
    color: var(--burgundy);
    border-color: var(--cream);
  }
</style>
