const categorias = [
  { id: "entradas", nombre: "Entradas" },
  { id: "brasas", nombre: "Brasas" },
  { id: "importados", nombre: "Importados" },
  { id: "guarniciones", nombre: "Guarniciones" },
  { id: "especiales", nombre: "Especiales de la casa" },
  { id: "compartir", nombre: "Para compartir" },
  { id: "hamburguesas", nombre: "Hamburguesas" },
  { id: "infantil", nombre: "Menú infantil" },
  { id: "bebidas", nombre: "Bebidas" },
  { id: "cocteles", nombre: "Cócteles" },
];
---

<Layout title="Menú - LF Steakhouse">
  <Header currentPage="/menu" />
  <main>
    <MenuHeader />
    <MenuNav categorias={categorias} />

    <div class="content">
      <MenuSection id="entradas" titulo="Entradas" items={menuData.entradas} />
      <MenuSection id="brasas" titulo="Brasas" items={menuData.brasas} />
      <MenuSection
        id="importados"
        titulo="Importados"
        items={menuData.importados}
      />
      <section id="guarniciones" class="guarniciones-section">
        <header class="guarniciones-header">
          <h2 class="guarniciones-title">Escoge tu Guarnición</h2>
        </header>
        <ul class="guarniciones-list">
          <li>Papa Francesa Artesanal</li>
          <li>Papas Criollas</li>
          <li>Papa Americana</li>
          <li>Vegetales a la Brasa</li>
        </ul>
        <div class="guarnicion-extra">
          <div class="guarnicion-extra-row">
            <span class="guarnicion-extra-name">Desgranado con Salsa de Tocineta y Queso</span>
            <span class="guarnicion-extra-line" />
            <span class="guarnicion-extra-price">$4.900</span>
          </div>
          <span class="guarnicion-extra-note">Valor adicional</span>
        </div>
      </section>

      <MenuSection
        id="especiales"
        titulo="Especiales de la casa"
        items={menuData.especiales}
      />
      <MenuSection
        id="compartir"
        titulo="Para compartir"
        items={menuData.compartir}
      />
      <MenuSection
        id="hamburguesas"
        titulo="Hamburguesas"
        items={menuData.hamburguesas}
      />
      <MenuSection
        id="infantil"
        titulo="Menú infantil"
        items={menuData.infantil}
      />
      <MenuSection id="bebidas" titulo="Bebidas" items={menuData.bebidas} />
      <MenuSection id="cocteles" titulo="Cócteles" items={menuData.cocteles} />
    </div>

    <footer>
      <div class="ornament">
        <span class="line"></span>
        <span class="dot"></span>
        <span class="line"></span>
      </div>
      <p class="note">Precios incluyen IVA</p>
      <p class="allergy">
        Por favor, informe a su mesero sobre cualquier alergia alimentaria
      </p>
    </footer>
  </main>
</Layout>

<style>
  main {
    max-width: 500px;
    margin: 0 auto;
    padding-top: 60px;
    padding-bottom: 60px;
  }

  @media (min-width: 640px) {
    main {
      max-width: 560px;
    }
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 24px 20px 0;
  }

  @media (min-width: 640px) {
    .content {
      gap: 48px;
      padding: 32px 28px 0;
    }
  }

  footer {
    margin-top: 100px;
    padding: 24px 20px 0;
    text-align: center;
  }

  .ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .line {
    width: 32px;
    height: 1px;
    background-color: rgba(245, 230, 200, 0.2);
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: rgba(245, 230, 200, 0.3);
  }

  .note {
    font-family: "Montserrat", sans-serif;
    font-size: 11px;
    font-weight: 400;
    color: rgba(245, 230, 200, 0.8);
    letter-spacing: 1px;
    margin: 0;
  }

  .guarniciones-section {
    scroll-margin-top: 120px;
  }

  @media (min-width: 768px) {
    .guarniciones-section {
      scroll-margin-top: 130px;
    }
  }

  .guarniciones-header {
    text-align: center;
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(245, 230, 200, 0.2);
  }

  .guarniciones-title {
    font-family: "Cormorant Garamond", serif;
    font-size: 24px;
    font-weight: 600;
    color: #f5e6c8;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin: 0;
  }

  @media (min-width: 640px) {
    .guarniciones-title {
      font-size: 28px;
      letter-spacing: 4px;
    }
  }

  .guarniciones-list {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .guarniciones-list li {
    font-family: "Cormorant Garamond", serif;
    font-size: 18px;
    font-weight: 500;
    color: #f5e6c8;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .guarniciones-list li::before {
    content: "";
    width: 5px;
    height: 5px;
    background-color: rgba(245, 230, 200, 0.4);
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .guarniciones-list li {
      font-size: 20px;
    }
  }

  .guarnicion-extra {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 16px;
    border-top: 1px solid rgba(245, 230, 200, 0.1);
  }

  .guarnicion-extra-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    width: 100%;
  }

  .guarnicion-extra-name {
    font-family: "Cormorant Garamond", serif;
    font-size: 18px;
    font-weight: 500;
    color: #f5e6c8;
    flex-shrink: 0;
  }

  .guarnicion-extra-line {
    flex: 1;
    height: 1px;
    background: repeating-linear-gradient(
      to right,
      rgba(245, 230, 200, 0.3),
      rgba(245, 230, 200, 0.3) 2px,
      transparent 2px,
      transparent 6px
    );
    min-width: 20px;
    position: relative;
    top: -4px;
  }

  .guarnicion-extra-price {
    font-family: "Cormorant Garamond", serif;
    font-size: 18px;
    font-weight: 500;
    color: #f5e6c8;
    flex-shrink: 0;
  }

  .guarnicion-extra-note {
    font-family: "Montserrat", sans-serif;
    font-size: 11px;
    font-weight: 300;
    color: rgba(245, 230, 200, 0.5);
    font-style: italic;
  }

  @media (min-width: 640px) {
    .guarnicion-extra-name,
    .guarnicion-extra-price {
      font-size: 20px;
    }
  }

  .allergy {
    font-family: "Montserrat", sans-serif;
    font-size: 10px;
    font-weight: 300;
    color: rgba(245, 230, 200, 0.75);
    margin: 8px 0 0;
    font-style: italic;
  }
</style>
