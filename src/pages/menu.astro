const categorias = [
  { id: "entradas",      nombre: "Entradas",            en: "Starters" },
  { id: "brasas",        nombre: "Brasas",              en: "From the Grill" },
  { id: "importados",    nombre: "Importados",          en: "Imported Cuts" },
  { id: "guarniciones",  nombre: "Guarniciones",        en: "Side Dishes" },
  { id: "especiales",    nombre: "Especiales de la casa", en: "House Specials" },
  { id: "compartir",     nombre: "Para compartir",      en: "To Share" },
  { id: "hamburguesas",  nombre: "Hamburguesas",        en: "Burgers" },
  { id: "infantil",      nombre: "Menú infantil",       en: "Kids' Menu" },
  { id: "bebidas",       nombre: "Bebidas",             en: "Drinks" },
  { id: "cocteles",      nombre: "Cócteles",            en: "Cocktails" },
