---

<Layout
  title="Menú del Restaurante en Caucasia | LF Steakhouse"
  description="Explora el menú de LF Steakhouse en Caucasia: cortes importados, brasas, especiales de la casa, cócteles artesanales y más. Cocina premium en el Bajo Cauca Antioquia."
>
  <Header currentPage="/menu" />
  <main>
    <MenuHeader />
    <MenuNav categorias={categorias} />

    <div class="content">
      <MenuSection id="entradas" titulo="Entradas" tituloEn="Starters" items={menuData.entradas} />
      <MenuSection id="brasas" titulo="Brasas" tituloEn="From the Grill" items={menuData.brasas} />
      <MenuSection id="importados" titulo="Importados" tituloEn="Imported Cuts" items={menuData.importados} />

      <section id="guarniciones" class="guarniciones-section">
        <header class="guarniciones-header">
          <h2 class="guarniciones-title">
            <Trans es="Escoge tu Guarnición" en="Choose Your Side Dish" />
          </h2>
        </header>
        <ul class="guarniciones-list">
          <li><Trans es="Papa Francesa Artesanal" en="Artisan French Fries" /></li>
          <li><Trans es="Papas Criollas" en="Criolla Potatoes" /></li>
          <li><Trans es="Papa Americana" en="American Style Potato" /></li>
          <li><Trans es="Vegetales a la Brasa" en="Grilled Vegetables" /></li>
        </ul>
        <div class="guarnicion-extra">
          <div class="guarnicion-extra-row">
            <span class="guarnicion-extra-name">
              <Trans es="Desgranado con Salsa de Tocineta y Queso" en="Corn Kernels with Bacon and Cheese Sauce" />
            </span>
            <span class="guarnicion-extra-line" />
            <span class="guarnicion-extra-price">$4.900</span>
          </div>
          <span class="guarnicion-extra-note">
            <Trans es="valor adicional" en="additional charge" />
          </span>
        </div>
      </section>

      <MenuSection id="especiales" titulo="Especiales de la casa" tituloEn="House Specials" items={menuData.especiales} />
      <MenuSection id="compartir" titulo="Para compartir" tituloEn="To Share" items={menuData.compartir} />
      <MenuSection id="hamburguesas" titulo="Hamburguesas" tituloEn="Burgers" items={menuData.hamburguesas} />
      <MenuSection id="infantil" titulo="Menú infantil" tituloEn="Kids' Menu" items={menuData.infantil} />
      <MenuSection id="bebidas" titulo="Bebidas" tituloEn="Drinks" items={menuData.bebidas} />
      <MenuSection id="cocteles" titulo="Cócteles" tituloEn="Cocktails" items={menuData.cocteles} />
    </div>

    <footer>
      <div class="ornament">
        <span class="line"></span>
        <span class="dot"></span>
        <span class="line"></span>
      </div>
      <p class="note"><Trans es="Precios incluyen IVA" en="Prices include tax" /></p>
      <p class="allergy">
        <Trans
          es="Por favor, informe a su mesero sobre cualquier alergia alimentaria"
          en="Please inform your server about any food allergies"
        />
      </p>
      <div class="reserve-cta">
        <a href="/reservar" class="reserve-btn">
          <Trans es="Reservar Mesa" en="Reserve a Table" />
        </a>
      </div>
    </footer>
  </main>
</Layout>

<style>
  main {
    max-width: 500px;
    margin: 0 auto;
    padding-top: var(--header-height, 100px);
    padding-bottom: 60px;
  }

  @media (min-width: 640px) {
    main {
      max-width: 560px;
    }
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 24px 20px 0;
  }

  @media (min-width: 640px) {
    .content {
      gap: 48px;
      padding: 32px 28px 0;
    }
  }

  footer {
    margin-top: 100px;
    padding: 24px 20px 0;
    text-align: center;
  }

  .ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .line {
    width: 32px;
    height: 1px;
    background-color: rgba(245, 230, 200, 0.2);
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: rgba(245, 230, 200, 0.3);
  }

  .note {
    font-family: "Montserrat", sans-serif;
    font-size: 11px;
    font-weight: 400;
    color: rgba(245, 230, 200, 0.8);
    letter-spacing: 1px;
    margin: 0;
  }

  .allergy {
    font-family: "Montserrat", sans-serif;
    font-size: 10px;
    font-weight: 300;
    color: rgba(245, 230, 200, 0.75);
    margin: 8px 0 0;
    font-style: italic;
  }

  .reserve-cta {
    margin-top: 32px;
  }

  .reserve-btn {
    display: inline-block;
    font-family: "Montserrat", sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    background-color: #f5e6c8;
    color: #3d1f1f;
    padding: 16px 40px;
    transition: all 0.3s ease;
  }

  .reserve-btn:hover {
    background-color: #fff8e7;
    transform: translateY(-2px);
  }

  /* Guarniciones */
  .guarniciones-section {
    scroll-margin-top: 120px;
  }

  @media (min-width: 768px) {
    .guarniciones-section {
      scroll-margin-top: 130px;
    }
  }

  .guarniciones-header {
    text-align: center;
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(245, 230, 200, 0.2);
  }

  .guarniciones-title {
    font-family: "Cormorant Garamond", serif;
    font-size: 24px;
    font-weight: 600;
    color: #f5e6c8;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin: 0;
  }

  @media (min-width: 640px) {
    .guarniciones-title {
      font-size: 28px;
      letter-spacing: 4px;
    }
  }

  .guarniciones-list {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .guarniciones-list li {
    font-family: "Cormorant Garamond", serif;
    font-size: 18px;
    font-weight: 500;
    color: #f5e6c8;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .guarniciones-list li::before {
    content: "";
    width: 5px;
    height: 5px;
    background-color: rgba(245, 230, 200, 0.4);
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .guarniciones-list li {
      font-size: 20px;
    }
  }

  .guarnicion-extra {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 16px;
    border-top: 1px solid rgba(245, 230, 200, 0.1);
  }

  .guarnicion-extra-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    width: 100%;
  }

  .guarnicion-extra-name {
    font-family: "Cormorant Garamond", serif;
    font-size: 18px;
    font-weight: 500;
    color: #f5e6c8;
    flex-shrink: 0;
  }

  .guarnicion-extra-line {
    flex: 1;
    height: 1px;
    background: repeating-linear-gradient(
      to right,
      rgba(245, 230, 200, 0.3),
      rgba(245, 230, 200, 0.3) 2px,
      transparent 2px,
      transparent 6px
    );
    min-width: 20px;
    position: relative;
    top: -4px;
  }

  .guarnicion-extra-price {
    font-family: "Cormorant Garamond", serif;
    font-size: 18px;
    font-weight: 500;
    color: #f5e6c8;
    flex-shrink: 0;
  }

  .guarnicion-extra-note {
    font-family: "Montserrat", sans-serif;
    font-size: 11px;
    font-weight: 300;
    color: rgba(245, 230, 200, 0.5);
    font-style: italic;
  }

  @media (min-width: 640px) {
    .guarnicion-extra-name,
    .guarnicion-extra-price {
      font-size: 20px;
    }
  }
</style>
